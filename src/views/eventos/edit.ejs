<script>
document.addEventListener('alpine:init', function() {
    Alpine.data('eventoEditForm', function() {
        return {
            selectedSec: <%- evento.secretaria_id %>,
            allUsers: <%- JSON.stringify(users.map(function(u){ return { id: u.id, nome: u.nome, secretaria_id: u.secretaria_id }; })) %>,
            responsaveis: <%- JSON.stringify(evento.responsaveis ? evento.responsaveis.map(function(r){ return r.id; }) : []) %>,
            get filteredUsers() {
                if (!this.selectedSec) return [];
                var sec = this.selectedSec;
                return this.allUsers.filter(function(u){ return u.secretaria_id == sec; });
            },
            toggle: function(id) {
                var i = this.responsaveis.indexOf(id);
                if (i >= 0) this.responsaveis.splice(i, 1); else this.responsaveis.push(id);
            },
            isSelected: function(id) { return this.responsaveis.indexOf(id) >= 0; }
        };
    });
});
</script>

<%
    var fmtDT = function(d) {
        if (!d) return '';
        var dt = new Date(d);
        var pad = function(n) { return String(n).padStart(2,'0'); };
        return dt.getFullYear() + '-' + pad(dt.getMonth()+1) + '-' + pad(dt.getDate())
             + 'T' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
    };
    var calendarioMenu = '' +
        '<div class="relative" x-data="{ calOpen: false }" @click.outside="calOpen = false">' +
        '  <button type="button" @click.stop="calOpen = !calOpen" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:border-emerald-400 hover:text-emerald-700 hover:bg-emerald-50 transition shadow-sm">' +
        '    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>' +
        '    Adicionar ao Calendário' +
        '  </button>' +
        '  <div x-show="calOpen" style="display:none" class="absolute right-0 top-full mt-1.5 z-30 bg-white border border-gray-200 rounded-xl shadow-xl overflow-hidden w-56">' +
        '    <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100">Publicar em</div>' +
        '    <a id="edit-gcal-link" href="#" target="_blank" rel="noopener" @click="calOpen = false" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">' +
        '      <span class="w-5 h-5 bg-blue-600 text-white text-[10px] font-black rounded flex items-center justify-center shrink-0">G</span>Google Calendar' +
        '    </a>' +
        '    <div class="h-px bg-gray-100 mx-3"></div>' +
        '    <button type="button" onclick="editIcsDownload()" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition">' +
        '      <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>Apple / iCal (.ics)' +
        '    </button>' +
        '  </div>' +
        '</div>';
%>

<div class="max-w-6xl mx-auto space-y-6" x-data="eventoEditForm">

    <%- include('../partials/form-header', {
        backHref: '/eventos',
        title: 'Editar Evento',
        subtitle: 'Atualize as informações do evento institucional.',
        headerRight: calendarioMenu
    }) %>

    <form action="/eventos/<%= evento.id %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl border border-gray-200 shadow-sm">

        <!-- 2-column grid -->
        <div class="p-6 grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-x-8 gap-y-5">

            <!-- ─── Coluna esquerda: dados principais ─── -->
            <div class="space-y-5">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Título do Evento <span class="text-red-500">*</span></label>
                    <input type="text" name="titulo" id="titulo-evento" required value="<%= evento.titulo %>"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Descrição <span class="text-red-500">*</span></label>
                    <%- include('../partials/quill-ia-field', {
                        editorId: 'ed-evento',
                        inputName: 'descricao',
                        titleInputId: 'titulo-evento',
                        placeholder: 'Descreva o evento com detalhes: objetivo, público, programação...',
                        initialHtml: evento.descricao || '',
                        required: true
                    }) %>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Local <span class="text-red-500">*</span></label>
                    <input type="text" name="local" required value="<%= evento.local %>"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
                </div>

                <!-- Imagem de Capa -->
                <div x-data="{
                    preview: null,
                    fileName: '',
                    currentCapa: '<%= evento.imagem_capa || '' %>',
                    removida: false,
                    onChange(e) {
                        var f = e.target.files[0];
                        if (!f) return;
                        this.fileName = f.name;
                        this.removida = false;
                        var reader = new FileReader();
                        reader.onload = (ev) => { this.preview = ev.target.result; };
                        reader.readAsDataURL(f);
                    },
                    clear() { this.preview = null; this.fileName = ''; this.$refs.input.value = ''; },
                    async removerAtual() {
                        if (!confirm('Remover a imagem de capa atual?')) return;
                        const r = await fetch('/eventos/<%= evento.id %>/remover-capa', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                        const d = await r.json();
                        if (d.ok) { this.currentCapa = ''; this.removida = true; }
                    }
                }">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Imagem de Capa <span class="text-gray-400 font-normal">(opcional)</span></label>

                    <div x-show="currentCapa && !preview" class="relative rounded-xl overflow-hidden border border-gray-200 shadow-sm mb-3">
                        <img :src="currentCapa" class="w-full h-48 object-cover">
                        <div class="absolute inset-0 bg-black/30 flex items-end p-3">
                            <span class="text-white text-xs font-medium flex-1">Capa atual</span>
                            <button type="button" @click.prevent="removerAtual()"
                                class="ml-2 px-2.5 py-1 bg-red-500/80 hover:bg-red-600 rounded-lg text-white text-xs font-medium transition">Remover</button>
                            <button type="button" @click.prevent="$refs.input.click()"
                                class="ml-2 px-2.5 py-1 bg-white/80 hover:bg-white rounded-lg text-gray-700 text-xs font-medium transition">Trocar</button>
                        </div>
                    </div>

                    <div x-show="!currentCapa && !preview"
                        class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-blue-400 hover:bg-blue-50/40 transition cursor-pointer"
                        @click="$refs.input.click()"
                        @dragover.prevent
                        @drop.prevent="onChange({ target: { files: $event.dataTransfer.files } })">
                        <svg class="w-10 h-10 mx-auto text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <p class="text-sm text-gray-500">Clique ou arraste uma imagem aqui</p>
                        <p class="text-xs text-gray-400 mt-1">JPG, PNG, WebP — máx. 10 MB</p>
                    </div>

                    <div x-show="preview" class="relative rounded-xl overflow-hidden border border-gray-200 shadow-sm">
                        <img :src="preview" class="w-full h-48 object-cover">
                        <div class="absolute inset-0 bg-black/30 flex items-end p-3">
                            <span class="text-white text-xs font-medium truncate flex-1" x-text="fileName"></span>
                            <button type="button" @click.stop="clear()"
                                class="ml-2 w-7 h-7 flex items-center justify-center bg-white/20 hover:bg-white/40 rounded-full transition text-white shrink-0" title="Cancelar">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                        <button type="button" @click="$refs.input.click()"
                            class="absolute top-2 right-10 bg-white/80 hover:bg-white text-gray-700 text-xs px-2 py-1 rounded-lg shadow transition">Trocar</button>
                    </div>

                    <input type="file" name="capa" accept="image/*" x-ref="input" @change="onChange($event)" class="hidden">
                </div>

            </div>

            <!-- ─── Coluna direita: metadados ─── -->
            <div class="space-y-5">

                <div class="bg-gray-50 rounded-xl border border-gray-100 p-5 space-y-5">
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Dados do Evento</p>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Data e Hora de Início <span class="text-red-500">*</span></label>
                        <input type="datetime-local" name="data_inicio" required value="<%= fmtDT(evento.data_inicio) %>"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Data e Hora de Fim <span class="text-red-500">*</span></label>
                        <input type="datetime-local" name="data_fim" required value="<%= fmtDT(evento.data_fim) %>"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Tipo de Evento <span class="text-red-500">*</span></label>
                        <select name="tipo" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                            <option value="">Selecione...</option>
                            <% ['Coletiva de Imprensa','Inauguração','Cerimônia','Reunião','Evento Cultural','Ação Social','Outros'].forEach(function(t) { %>
                                <option value="<%= t %>" <%= evento.tipo === t ? 'selected' : '' %>><%= t %></option>
                            <% }) %>
                        </select>
                    </div>

                    <% if(['admin', 'secom', 'super_admin'].includes(user.role)) { %>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Secretaria <span class="text-red-500">*</span></label>
                        <select name="secretaria_id" required
                            @change="selectedSec = parseInt($event.target.value) || null; responsaveis = []"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                            <option value="">Selecione...</option>
                            <% secretarias.forEach(function(s) { %>
                                <option value="<%= s.id %>" <%= evento.secretaria_id == s.id ? 'selected' : '' %>><%= s.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>

                    <!-- Responsáveis -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Responsáveis pelo Evento</label>
                        <div x-show="filteredUsers.length > 0" class="flex flex-wrap gap-2">
                            <template x-for="u in filteredUsers" :key="u.id">
                                <button type="button" @click="toggle(u.id)"
                                    class="flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm font-medium transition select-none"
                                    :class="isSelected(u.id) ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-white text-gray-700 border-gray-300 hover:border-blue-400 hover:text-blue-600'">
                                    <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px] font-bold"
                                        :class="isSelected(u.id) ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-500'"
                                        x-text="u.nome.charAt(0)"></span>
                                    <span x-text="u.nome"></span>
                                </button>
                            </template>
                        </div>
                        <p x-show="!selectedSec" class="text-sm text-gray-400 italic">
                            Selecione uma secretaria para ver os responsáveis disponíveis.
                        </p>
                        <p x-show="selectedSec && filteredUsers.length === 0" class="text-sm text-gray-400 italic">
                            Nenhum usuário cadastrado para esta secretaria.
                        </p>
                        <template x-for="id in responsaveis" :key="id">
                            <input type="hidden" name="responsaveis[]" :value="id">
                        </template>
                    </div>
                </div>

            </div>

        </div>

        <%- include('../partials/form-footer', {
            cancelHref: '/eventos',
            submitLabel: 'Salvar Alterações'
        }) %>
    </form>
</div>

<script>
(function() {
    var _ev = {
        titulo:      <%- JSON.stringify(evento.titulo) %>,
        descricao:   <%- JSON.stringify(evento.descricao || '') %>,
        local:       <%- JSON.stringify(evento.local || '') %>,
        data_inicio: <%- JSON.stringify(evento.data_inicio) %>,
        data_fim:    <%- JSON.stringify(evento.data_fim) %>
    };
    var pad = function(n) { return String(n).padStart(2, '0'); };
    var fmtUtc = function(d) {
        var dt = new Date(d);
        return dt.getUTCFullYear()+pad(dt.getUTCMonth()+1)+pad(dt.getUTCDate())
             +'T'+pad(dt.getUTCHours())+pad(dt.getUTCMinutes())+pad(dt.getUTCSeconds())+'Z';
    };
    var gcalLink = document.getElementById('edit-gcal-link');
    if (gcalLink) {
        gcalLink.href = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
            +'&text='+encodeURIComponent(_ev.titulo)
            +'&dates='+fmtUtc(_ev.data_inicio)+'/'+fmtUtc(_ev.data_fim)
            +'&details='+encodeURIComponent(_ev.descricao)
            +'&location='+encodeURIComponent(_ev.local);
    }
    window.editIcsDownload = function() {
        var esc = function(s) { return String(s||'').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;'); };
        var content = [
            'BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Comunica//PT-BR',
            'CALSCALE:GREGORIAN','METHOD:PUBLISH','BEGIN:VEVENT',
            'UID:'+Date.now()+'@comunica',
            'DTSTART:'+fmtUtc(_ev.data_inicio),'DTEND:'+fmtUtc(_ev.data_fim),
            'SUMMARY:'+esc(_ev.titulo),'DESCRIPTION:'+esc(_ev.descricao),'LOCATION:'+esc(_ev.local),
            'BEGIN:VALARM','TRIGGER:-PT1H','ACTION:DISPLAY',
            'DESCRIPTION:Lembrete: '+esc(_ev.titulo),
            'END:VALARM','END:VEVENT','END:VCALENDAR'
        ].join('\r\n');
        var blob = new Blob([content], {type:'text/calendar;charset=utf-8'});
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = _ev.titulo.replace(/[^a-z0-9]/gi,'_')+'.ics';
        document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(a.href);
    };
}());
</script>
