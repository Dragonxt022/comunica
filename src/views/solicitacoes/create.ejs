<%- include('../partials/quill-styles.ejs') %>
<script>
document.addEventListener('alpine:init', function() {
    Alpine.data('solCreateForm', function() {
        return {
            quill: null,
            criarEvento: false,
            selectedMun: <%- user.role === 'super_admin' && activeMunicipioId ? activeMunicipioId : 'null' %>,
            selectedSec: <%- (user.role === 'secretaria' || user.role === 'secom') && user.secretaria_id ? user.secretaria_id : 'null' %>,
            allUsers: <%- JSON.stringify(users.map(function(u){ return { id: u.id, nome: u.nome, secretaria_id: u.secretaria_id, municipio_id: u.municipio_id }; })) %>,
            allSecretarias: <%- JSON.stringify(secretarias.map(function(s){ return { id: s.id, nome: s.nome, municipio_id: s.municipio_id }; })) %>,
            responsaveis: [],
            tiposSelecionados: [],
            permitirMultiplos: <%- JSON.stringify(!!(config && config.permitir_multiplos_tipos_midia)) %>,
            iaLoadingSugestao: false,
            iaLoadingCorrecao: false,
            chatOpen: false,
            chatMensagens: [],
            chatInput: '',
            chatLoading: false,
            toast: '',
            toastOk: true,
            init: function() {
                this.quill = new Quill(this.$refs.quillEditor, {
                    theme: 'snow',
                    placeholder: 'Descreva com detalhes o que precisa ser produzido: contexto, público-alvo, referências visuais, informações importantes e qualquer prazo relevante...',
                    modules: {
                        toolbar: [
                            [{ header: [2, 3, false] }],
                            ['bold', 'italic', 'underline'],
                            [{ align: [] }],
                            [{ list: 'ordered' }, { list: 'bullet' }],
                            ['link'],
                            ['clean'],
                        ],
                    },
                });
            },
            setQuillText: function(text) {
                // Evita bug do Quill 1.3.7: chamar setText() enquanto o foco/seleção
                // do navegador está em outro elemento (botão, textarea do chat) corrompe
                // o range interno do editor e trava a edição. Limpar a seleção nativa
                // e tirar o foco do elemento ativo antes de escrever resolve.
                if (document.activeElement && document.activeElement !== document.body) {
                    document.activeElement.blur();
                }
                var sel = window.getSelection && window.getSelection();
                if (sel) sel.removeAllRanges();
                this.quill.setText(text);
            },
            prepararSubmit: function(event) {
                var html = this.quill.root.innerHTML;
                var vazio = html === '<p><br></p>';
                this.$refs.descricaoInput.value = vazio ? '' : html;
                if (vazio) {
                    event.preventDefault();
                    this.showToast('Escreva a descrição/briefing antes de enviar.', false);
                }
            },
            get filteredSecretarias() {
                if (!this.selectedMun) return this.allSecretarias;
                var mid = this.selectedMun;
                return this.allSecretarias.filter(function(s){ return s.municipio_id == mid; });
            },
            get filteredUsers() {
                var us = this.allUsers;
                if (this.selectedMun) {
                    var mid = this.selectedMun;
                    us = us.filter(function(u){ return u.municipio_id == mid; });
                }
                if (!this.selectedSec) return us;
                var sec = this.selectedSec;
                return us.filter(function(u){ return u.secretaria_id == sec; });
            },
            changeMun: function(val) {
                this.selectedMun = parseInt(val) || null;
                this.selectedSec = null;
                this.responsaveis = [];
            },
            toggleResp: function(id) {
                var i = this.responsaveis.indexOf(id);
                if (i >= 0) this.responsaveis.splice(i, 1); else this.responsaveis.push(id);
            },
            isResp: function(id) { return this.responsaveis.indexOf(id) >= 0; },
            toggleTipo: function(v) {
                if (!this.permitirMultiplos) { this.tiposSelecionados = [v]; return; }
                var i = this.tiposSelecionados.indexOf(v);
                if (i >= 0) this.tiposSelecionados.splice(i, 1); else this.tiposSelecionados.push(v);
            },
            isTipo: function(v) { return this.tiposSelecionados.indexOf(v) >= 0; },
            get tiposLabel() {
                if (this.tiposSelecionados.length === 0) return 'Selecione os tipos…';
                return this.tiposSelecionados.join(', ');
            },
            showToast: function(msg, ok) {
                var self = this;
                this.toast = msg;
                this.toastOk = ok;
                setTimeout(function() { self.toast = ''; }, 3000);
            },
            sugerirDescricao: async function() {
                var titulo = this.$refs.tituloInput.value.trim();
                if (!titulo) { this.showToast('Preencha o título primeiro.', false); return; }
                this.iaLoadingSugestao = true;
                try {
                    var res = await fetch('/ia/sugerir-descricao', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ titulo: titulo }),
                    });
                    var data = await res.json();
                    if (res.ok) {
                        this.setQuillText(data.descricao);
                        this.showToast(data.usouFallback ? 'Sugestão gerada com modelo local (nuvem indisponível) — revise antes de enviar.' : 'Sugestão gerada — revise antes de enviar.', true);
                    } else {
                        this.showToast(data.error || 'Erro ao gerar sugestão.', false);
                    }
                } catch (err) {
                    this.showToast('Assistente de IA indisponível no momento.', false);
                } finally {
                    this.iaLoadingSugestao = false;
                }
            },
            corrigirDescricao: async function() {
                var texto = this.quill.getText().trim();
                if (!texto) { this.showToast('Escreva a descrição antes de corrigir.', false); return; }
                this.iaLoadingCorrecao = true;
                try {
                    var res = await fetch('/ia/corrigir-texto', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ texto: texto }),
                    });
                    var data = await res.json();
                    if (res.ok) {
                        this.setQuillText(data.texto);
                        this.showToast(data.usouFallback ? 'Texto corrigido com modelo local (nuvem indisponível) — revise antes de enviar.' : 'Texto corrigido — revise antes de enviar.', true);
                    } else {
                        this.showToast(data.error || 'Erro ao corrigir texto.', false);
                    }
                } catch (err) {
                    this.showToast('Assistente de IA indisponível no momento.', false);
                } finally {
                    this.iaLoadingCorrecao = false;
                }
            },
            abrirChat: function() {
                this.chatOpen = true;
                if (this.chatMensagens.length === 0) {
                    this.chatMensagens.push({ role: 'assistant', texto: 'Me conte o que você precisa: contexto, público-alvo, informações importantes, prazo... Quanto mais detalhes, melhor fica o briefing estruturado.' });
                }
            },
            fecharChat: function() { this.chatOpen = false; },
            enviarChat: async function() {
                var texto = this.chatInput.trim();
                if (!texto || this.chatLoading) return;
                this.chatMensagens.push({ role: 'user', texto: texto });
                this.chatInput = '';
                this.chatLoading = true;
                this.scrollChatToBottom();
                try {
                    var titulo = this.$refs.tituloInput.value.trim();
                    var res = await fetch('/ia/estruturar-chamado', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ titulo: titulo, mensagens: this.chatMensagens }),
                    });
                    var data = await res.json();
                    if (res.ok) {
                        this.chatMensagens.push({ role: 'assistant', texto: data.resposta });
                        if (data.usouFallback) this.showToast('Resposta gerada com modelo local (nuvem indisponível).', true);
                    } else {
                        this.chatMensagens.push({ role: 'assistant', texto: data.error || 'Erro ao consultar a IA.' });
                    }
                } catch (err) {
                    this.chatMensagens.push({ role: 'assistant', texto: 'Assistente de IA indisponível no momento.' });
                } finally {
                    this.chatLoading = false;
                    this.scrollChatToBottom();
                }
            },
            scrollChatToBottom: function() {
                var box = this.$refs.chatBox;
                this.$nextTick(function() { if (box) box.scrollTop = box.scrollHeight; });
            },
            adicionarAoFormulario: async function() {
                var ultima = null;
                for (var i = this.chatMensagens.length - 1; i >= 0; i--) {
                    if (this.chatMensagens[i].role === 'assistant') { ultima = this.chatMensagens[i]; break; }
                }
                if (!ultima) { this.showToast('Converse com a IA antes de adicionar.', false); return; }
                this.setQuillText(ultima.texto);
                this.chatOpen = false;
                this.showToast('Texto estruturado adicionado ao formulário — revise antes de enviar.', true);

                // Preenche o título automaticamente, se ainda estiver vazio
                var tituloInput = this.$refs.tituloInput;
                if (tituloInput && !tituloInput.value.trim()) {
                    try {
                        var res = await fetch('/ia/sugerir-titulo', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ texto: ultima.texto }),
                        });
                        var data = await res.json();
                        if (res.ok && data.titulo) tituloInput.value = data.titulo;
                    } catch (err) { /* título é opcional */ }
                }
            },
        };
    });
});
</script>

<div class="max-w-6xl mx-auto space-y-5" x-data="solCreateForm">
    <div class="flex items-center gap-3">
        <a href="/solicitacoes" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </a>
        <div>
            <h1 class="text-xl font-bold text-gray-900">Abrir Chamado</h1>
            <p class="text-sm text-gray-500 mt-0.5">Solicite produção de material à equipe de comunicação.</p>
        </div>
    </div>

    <form action="/solicitacoes" method="POST" class="bg-white rounded-xl border border-gray-200 shadow-sm" @submit="prepararSubmit($event)">

        <!-- 2-column grid -->
        <div class="p-6 grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-x-8 gap-y-5">

            <!-- ─── Coluna esquerda ─── -->
            <div class="space-y-5">

                <div id="tour-titulo">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Título <span class="text-red-500">*</span></label>
                    <input type="text" name="titulo" x-ref="tituloInput" required placeholder="Ex: Nota sobre abertura de inscrições"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
                </div>

                <div id="tour-descricao" class="flex-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Descrição / Briefing <span class="text-red-500">*</span></label>
                    <p class="text-xs text-gray-500 mb-2.5">Explique o que precisa: contexto, público-alvo, referências e informações importantes. Quanto mais detalhes, melhor o resultado.</p>

                    <!-- Ações de IA — "Conversar" é a opção recomendada, as demais são atalhos -->
                    <div class="flex flex-wrap items-center gap-2 mb-2.5">
                        <button type="button" @click="abrirChat()"
                            title="Descreva em uma conversa e a IA organiza o briefing pra você"
                            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition shadow-sm">
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                Conversar com a IA
                        </button>
                        <button type="button" @click="sugerirDescricao()" :disabled="iaLoadingSugestao"
                            title="Gerar uma descrição automaticamente a partir do título"
                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-wait">
                            <svg x-show="!iaLoadingSugestao" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                            <svg x-show="iaLoadingSugestao" class="w-4 h-4 shrink-0 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                            <span x-text="iaLoadingSugestao ? 'Gerando…' : 'Gerar a partir do título'"></span>
                        </button>
                        <button type="button" @click="corrigirDescricao()" :disabled="iaLoadingCorrecao"
                            title="Corrigir ortografia e clareza do texto já escrito"
                            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-wait">
                            <svg x-show="!iaLoadingCorrecao" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <svg x-show="iaLoadingCorrecao" class="w-4 h-4 shrink-0 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                            <span x-text="iaLoadingCorrecao ? 'Corrigindo…' : 'Corrigir texto'"></span>
                        </button>
                    </div>

                    <div x-ref="quillEditor"></div>
                    <input type="hidden" name="descricao" x-ref="descricaoInput">
                    <p class="text-xs text-gray-400 mt-1">Sugestões de IA estão em fase de teste — revise sempre antes de enviar.</p>
                </div>

            </div>

            <!-- ─── Coluna direita ─── -->
            <div class="space-y-5">

                <div class="bg-gray-50 rounded-xl border border-gray-100 p-5 space-y-5">

                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 10.87V5a2 2 0 012-2z"></path></svg>
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tipo e Prioridade</p>
                    </div>

                    <!-- Tipos de Mídia -->
                    <div id="tour-tipos">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <%= config && config.permitir_multiplos_tipos_midia ? 'Tipo(s) de Mídia' : 'Tipo de Mídia' %> <span class="text-red-500">*</span>
                        </label>
                        <% if (config && config.permitir_multiplos_tipos_midia) { %>
                        <p class="text-xs text-gray-400 mb-2">Selecione um ou mais — cada tipo vira uma demanda separada.</p>
                        <% } %>
                        <div class="flex flex-wrap gap-2">
                            <% ['Nota','Release','Post para Redes Sociais','Arte Gráfica','Vídeo','Foto','Outros'].forEach(function(tipo) { %>
                            <button type="button" @click="toggleTipo('<%= tipo %>')"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition select-none"
                                :class="isTipo('<%= tipo %>')
                                    ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                                    : 'bg-white text-gray-700 border-gray-300 hover:border-blue-400 hover:text-blue-600'">
                                <svg x-show="isTipo('<%= tipo %>')" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                <%= tipo %>
                            </button>
                            <% }) %>
                        </div>
                        <p x-show="tiposSelecionados.length === 0" class="mt-2 text-xs text-red-400">Selecione pelo menos um tipo de mídia.</p>
                        <% if (config && config.permitir_multiplos_tipos_midia) { %>
                        <p x-show="tiposSelecionados.length > 1" class="mt-2 text-xs text-blue-600 font-medium">
                            <svg class="w-3.5 h-3.5 inline -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Serão criadas <span x-text="tiposSelecionados.length"></span> demandas separadas.
                        </p>
                        <% } %>
                        <template x-for="t in tiposSelecionados" :key="t">
                            <input type="hidden" name="tipos_midia" :value="t">
                        </template>
                    </div>

                    <!-- Prioridade + Prazo -->
                    <div id="tour-finalizar" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Prioridade <span class="text-red-500">*</span></label>
                            <select name="prioridade" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                                <option value="baixa">Baixa</option>
                                <option value="media" selected>Média</option>
                                <option value="alta">Alta — Urgente</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                                Prazo de Entrega
                                <span class="text-gray-400 font-normal">(opcional)</span>
                            </label>
                            <input type="date" name="prazo"
                                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition text-sm">
                        </div>
                    </div>

                    <% if(['admin', 'secom', 'super_admin'].includes(user.role)) { %>
                    <div class="pt-4 border-t border-gray-200 space-y-4">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21h2m4-18v18m4-18v18M9 7h1m-1 4h1m4-4h1m-1 4h1"></path></svg>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Destino do Chamado</p>
                        </div>
                    <% if(user.role === 'super_admin' && municipios && municipios.length > 0) { %>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Município <span class="text-red-500">*</span></label>
                        <select @change="changeMun($event.target.value)"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                            <option value="">Todos os municípios</option>
                            <% municipios.forEach(function(m) { %>
                                <option value="<%= m.id %>" <%= activeMunicipioId == m.id ? 'selected' : '' %>><%= m.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Secretaria <span class="text-red-500">*</span></label>
                        <select name="secretaria_id" required
                            @change="selectedSec = parseInt($event.target.value) || null; responsaveis = []"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                            <option value="">Selecione...</option>
                            <% if(user.role !== 'super_admin') { %>
                                <% secretarias.forEach(function(s) { %>
                                    <option value="<%= s.id %>"><%= s.nome %></option>
                                <% }) %>
                            <% } else { %>
                                <template x-for="s in filteredSecretarias" :key="s.id">
                                    <option :value="s.id" x-text="s.nome"></option>
                                </template>
                            <% } %>
                        </select>
                    </div>
                    </div>
                    <% } %>

                </div>

                <!-- Criar Evento Toggle -->
                <div class="border border-gray-200 rounded-xl overflow-hidden">
                    <button type="button" @click="criarEvento = !criarEvento"
                        class="w-full flex items-center gap-3 px-4 py-3 text-left transition"
                        :class="criarEvento ? 'bg-purple-50 border-b border-purple-200' : 'bg-gray-50 hover:bg-gray-100'">
                        <div class="w-5 h-5 rounded border-2 flex items-center justify-center shrink-0 transition"
                            :class="criarEvento ? 'border-purple-600 bg-purple-600' : 'border-gray-400 bg-white'">
                            <svg x-show="criarEvento" class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-gray-800">Criar evento também</p>
                            <p class="text-xs text-gray-500">Cadastrar um evento no calendário ao abrir este chamado.</p>
                        </div>
                        <svg class="w-4 h-4 text-gray-400 transition-transform shrink-0" :class="criarEvento ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <input type="hidden" name="criar_evento" :value="criarEvento ? '1' : '0'">

                    <div x-show="criarEvento" x-cloak class="p-4 space-y-4 bg-white">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Início <span class="text-red-500">*</span></label>
                                <input type="datetime-local" name="data_inicio" :required="criarEvento"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition text-sm">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Fim <span class="text-red-500">*</span></label>
                                <input type="datetime-local" name="data_fim" :required="criarEvento"
                                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition text-sm">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Local</label>
                            <input type="text" name="local" placeholder="Ex: Teatro Municipal"
                                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Evento <span class="text-red-500">*</span></label>
                            <select name="tipo_evento" :required="criarEvento"
                                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition text-sm">
                                <option value="">Selecione...</option>
                                <option value="Coletiva de Imprensa">Coletiva de Imprensa</option>
                                <option value="Inauguração">Inauguração</option>
                                <option value="Cerimônia">Cerimônia</option>
                                <option value="Reunião">Reunião</option>
                                <option value="Evento Cultural">Evento Cultural</option>
                                <option value="Ação Social">Ação Social</option>
                                <option value="Outros">Outros</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Responsáveis pelo Evento</label>
                            <div x-show="filteredUsers.length > 0" class="flex flex-wrap gap-2">
                                <template x-for="u in filteredUsers" :key="u.id">
                                    <button type="button" @click="toggleResp(u.id)"
                                        class="flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm font-medium transition select-none"
                                        :class="isResp(u.id) ? 'bg-purple-600 text-white border-purple-600 shadow-sm' : 'bg-white text-gray-700 border-gray-300 hover:border-purple-400'">
                                        <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px] font-bold"
                                            :class="isResp(u.id) ? 'bg-purple-500 text-white' : 'bg-gray-100 text-gray-500'"
                                            x-text="u.nome.charAt(0)"></span>
                                        <span x-text="u.nome"></span>
                                    </button>
                                </template>
                            </div>
                            <p x-show="filteredUsers.length === 0" class="text-sm text-gray-400 italic">Nenhum usuário disponível.</p>
                            <template x-for="id in responsaveis" :key="id">
                                <input type="hidden" name="responsaveis[]" :value="id">
                            </template>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="px-6 py-4 border-t border-gray-100 flex flex-wrap justify-between items-center gap-3 bg-gray-50 rounded-b-xl">
            <p class="text-xs text-gray-400 order-2 sm:order-1">Campos com <span class="text-red-500">*</span> são obrigatórios.</p>
            <div class="flex items-center gap-3 order-1 sm:order-2 ml-auto">
            <a href="/solicitacoes" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-600 font-medium hover:bg-white transition text-sm">Cancelar</a>
            <button type="submit"
                :disabled="tiposSelecionados.length === 0"
                :class="tiposSelecionados.length === 0 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-blue-700'"
                class="px-6 py-2.5 bg-blue-600 text-white rounded-lg font-semibold transition shadow-sm inline-flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span x-text="tiposSelecionados.length > 1 ? 'Criar ' + tiposSelecionados.length + ' Demandas' : 'Enviar Solicitação'"></span>
            </button>
            </div>
        </div>
    </form>

    <!-- Modal: Estruturar com IA (chat) -->
    <div x-show="chatOpen" x-cloak
        @keydown.escape.window="fecharChat()"
        class="fixed inset-0 z-50 flex items-center justify-center p-4"
        style="background:rgba(15,23,42,0.6);backdrop-filter:blur(2px)"
        @click.self="fecharChat()"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full h-[80vh] max-h-[700px] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-gray-900">Estruturar com IA</h3>
                        <p class="text-xs text-gray-400">Descreva o que precisa — a IA organiza o briefing</p>
                    </div>
                </div>
                <button type="button" @click="fecharChat()" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Mensagens -->
            <div class="flex-1 overflow-y-auto px-5 py-4 chat-scroll" x-ref="chatBox">
                <!-- Estado inicial: mensagem de boas-vindas centralizada -->
                <template x-if="chatMensagens.length <= 1">
                    <div class="h-full min-h-[220px] flex flex-col items-center justify-center text-center px-6 gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-purple-100 flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        </div>
                        <h4 class="text-base font-semibold text-gray-900">Vamos estruturar seu briefing</h4>
                        <p class="text-sm text-gray-500 leading-relaxed max-w-sm" x-text="chatMensagens.length ? chatMensagens[0].texto : ''"></p>
                    </div>
                </template>

                <!-- Conversa em andamento -->
                <template x-if="chatMensagens.length > 1">
                    <div class="space-y-5">
                        <template x-for="(msg, idx) in chatMensagens" :key="idx">
                            <div>
                                <template x-if="msg.role === 'user'">
                                    <div class="flex justify-end">
                                        <div class="max-w-[80%] rounded-2xl rounded-br-md bg-purple-600 text-white px-4 py-2.5 text-sm leading-relaxed whitespace-pre-wrap" x-text="msg.texto"></div>
                                    </div>
                                </template>
                                <template x-if="msg.role === 'assistant'">
                                    <div class="flex gap-2.5 max-w-[92%]">
                                        <div class="w-6 h-6 rounded-full bg-purple-100 flex items-center justify-center shrink-0 mt-0.5">
                                            <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                        </div>
                                        <div class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap pt-0.5" x-text="msg.texto"></div>
                                    </div>
                                </template>
                            </div>
                        </template>
                        <div x-show="chatLoading" class="flex gap-2.5">
                            <div class="w-6 h-6 rounded-full bg-purple-100 flex items-center justify-center shrink-0">
                                <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                            </div>
                            <div class="inline-flex items-center gap-1 pt-2.5">
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                                <span class="typing-dot"></span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Input -->
            <div class="border-t border-gray-100 p-3 space-y-2">
                <div class="flex items-end gap-1.5 rounded-2xl border border-gray-300 bg-white px-2 py-1.5 transition focus-within:border-purple-400 focus-within:ring-2 focus-within:ring-purple-100">
                    <textarea x-model="chatInput" rows="1" placeholder="Descreva o que precisa..."
                        @keydown.enter.exact.prevent="enviarChat()"
                        @input="$el.style.height = 'auto'; $el.style.height = Math.min($el.scrollHeight, 128) + 'px'"
                        :disabled="chatLoading"
                        class="flex-1 px-2 py-1.5 outline-none text-sm resize-none bg-transparent disabled:opacity-60 max-h-32"></textarea>
                    <button type="button" @click="enviarChat()" :disabled="chatLoading || !chatInput.trim()"
                        :class="(chatLoading || !chatInput.trim()) ? 'bg-gray-100 text-gray-300' : 'bg-purple-600 text-white hover:bg-purple-700'"
                        class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full transition disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0l-6 6m6-6l6 6"></path></svg>
                    </button>
                </div>
                <button type="button" @click="adicionarAoFormulario()"
                    :disabled="chatMensagens.filter(m => m.role === 'assistant').length === 0"
                    class="w-full px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 transition disabled:opacity-40 disabled:cursor-not-allowed inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Adicionar ao formulário
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div x-show="toast !== ''"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white"
        :class="toastOk ? 'bg-green-600' : 'bg-red-600'"
        x-text="toast">
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
