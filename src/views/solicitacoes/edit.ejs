<script>
document.addEventListener('alpine:init', function() {
    Alpine.data('solEditForm', function() {
        return {
            tipoSelecionado: '<%= sol.tipo_midia %>',
            iaLoadingSugestao: false,
            iaLoadingCorrecao: false,
            toast: '',
            toastOk: true,
            showToast: function(msg, ok) {
                var self = this;
                this.toast = msg;
                this.toastOk = ok;
                setTimeout(function() { self.toast = ''; }, 3000);
            },
            sugerirDescricao: async function() {
                var titulo = this.$refs.tituloInput.value.trim();
                if (!titulo) { this.showToast('Preencha o título primeiro.', false); return; }
                this.iaLoadingSugestao = true;
                try {
                    var res = await fetch('/ia/sugerir-descricao', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ titulo: titulo }),
                    });
                    var data = await res.json();
                    if (res.ok) {
                        this.$refs.descricaoInput.value = data.descricao;
                        this.showToast(data.usouFallback ? 'Sugestão gerada com modelo local (nuvem indisponível) — revise antes de enviar.' : 'Sugestão gerada — revise antes de enviar.', true);
                    } else {
                        this.showToast(data.error || 'Erro ao gerar sugestão.', false);
                    }
                } catch (err) {
                    this.showToast('Assistente de IA indisponível no momento.', false);
                } finally {
                    this.iaLoadingSugestao = false;
                }
            },
            corrigirDescricao: async function() {
                var texto = this.$refs.descricaoInput.value.trim();
                if (!texto) { this.showToast('Escreva a descrição antes de corrigir.', false); return; }
                this.iaLoadingCorrecao = true;
                try {
                    var res = await fetch('/ia/corrigir-texto', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ texto: texto }),
                    });
                    var data = await res.json();
                    if (res.ok) {
                        this.$refs.descricaoInput.value = data.texto;
                        this.showToast(data.usouFallback ? 'Texto corrigido com modelo local (nuvem indisponível) — revise antes de enviar.' : 'Texto corrigido — revise antes de enviar.', true);
                    } else {
                        this.showToast(data.error || 'Erro ao corrigir texto.', false);
                    }
                } catch (err) {
                    this.showToast('Assistente de IA indisponível no momento.', false);
                } finally {
                    this.iaLoadingCorrecao = false;
                }
            },
        };
    });
});
</script>

<div class="max-w-6xl mx-auto space-y-5" x-data="solEditForm">
    <div class="flex items-center gap-3">
        <a href="/solicitacoes/<%= sol.id %>" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </a>
        <div>
            <h1 class="text-xl font-bold text-gray-900">Editar Solicitação <span class="text-gray-400 font-normal">#<%= sol.id %></span></h1>
            <p class="text-sm text-gray-500 mt-0.5">Atualize as informações do chamado.</p>
        </div>
    </div>

    <form action="/solicitacoes/<%= sol.id %>/editar" method="POST" class="bg-white rounded-xl border border-gray-200 shadow-sm">

        <!-- 2-column grid -->
        <div class="p-6 grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-x-8 gap-y-5">

            <!-- ─── Coluna esquerda ─── -->
            <div class="space-y-5">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Título <span class="text-red-500">*</span></label>
                    <input type="text" name="titulo" x-ref="tituloInput" required value="<%= sol.titulo %>"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
                </div>

                <div class="flex-1">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-sm font-semibold text-gray-700">Descrição / Briefing <span class="text-red-500">*</span></label>
                        <div class="flex items-center gap-1.5">
                            <button type="button" @click="sugerirDescricao()" :disabled="iaLoadingSugestao"
                                title="Sugerir descrição a partir do título (IA — beta)"
                                class="inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-semibold rounded-md border border-indigo-200 text-indigo-600 hover:bg-indigo-50 transition disabled:opacity-50 disabled:cursor-wait">
                                <svg x-show="!iaLoadingSugestao" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                                <svg x-show="iaLoadingSugestao" class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                Sugerir com IA
                            </button>
                            <button type="button" @click="corrigirDescricao()" :disabled="iaLoadingCorrecao"
                                title="Corrigir ortografia e melhorar o texto (IA — beta)"
                                class="inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-semibold rounded-md border border-emerald-200 text-emerald-600 hover:bg-emerald-50 transition disabled:opacity-50 disabled:cursor-wait">
                                <svg x-show="!iaLoadingCorrecao" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <svg x-show="iaLoadingCorrecao" class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                Corrigir texto
                            </button>
                        </div>
                    </div>
                    <textarea name="descricao" x-ref="descricaoInput" required rows="14"
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition resize-y min-h-[280px]"><%= sol.descricao %></textarea>
                    <p class="text-xs text-gray-400 mt-1">Quanto mais detalhes, melhor o resultado da produção. Sugestões de IA estão em fase de teste — revise sempre antes de enviar.</p>
                </div>

            </div>

            <!-- ─── Coluna direita ─── -->
            <div class="space-y-5">

                <div class="bg-gray-50 rounded-xl border border-gray-100 p-5 space-y-5">

                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Configurações do Chamado</p>

                    <!-- Tipo de Mídia -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Tipo de Mídia <span class="text-red-500">*</span>
                        </label>
                        <div class="flex flex-wrap gap-2">
                            <% ['Nota','Release','Post para Redes Sociais','Arte Gráfica','Vídeo','Foto','Outros'].forEach(function(tipo) { %>
                            <button type="button" @click="tipoSelecionado = '<%= tipo %>'"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm font-medium transition select-none"
                                :class="tipoSelecionado === '<%= tipo %>'
                                    ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                                    : 'bg-white text-gray-700 border-gray-300 hover:border-blue-400 hover:text-blue-600'">
                                <svg x-show="tipoSelecionado === '<%= tipo %>'" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                <%= tipo %>
                            </button>
                            <% }) %>
                        </div>
                        <input type="hidden" name="tipo_midia" :value="tipoSelecionado">
                    </div>

                    <!-- Prioridade + Prazo -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Prioridade <span class="text-red-500">*</span></label>
                            <select name="prioridade" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                                <option value="baixa" <%= sol.prioridade === 'baixa' ? 'selected' : '' %>>Baixa</option>
                                <option value="media" <%= sol.prioridade === 'media' ? 'selected' : '' %>>Média</option>
                                <option value="alta"  <%= sol.prioridade === 'alta'  ? 'selected' : '' %>>Alta — Urgente</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                                Prazo de Entrega
                                <span class="text-gray-400 font-normal">(opcional)</span>
                            </label>
                            <input type="date" name="prazo"
                                value="<%= sol.prazo ? String(sol.prazo).slice(0, 10) : '' %>"
                                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition text-sm">
                            <% if(sol.prazo) {
                                var hoje = new Date().toISOString().slice(0,10);
                                var pStr = String(sol.prazo).slice(0,10);
                                var atrasado = pStr < hoje && !['finalizado','cancelado'].includes(sol.status);
                            %>
                            <p class="text-xs mt-1 <%= atrasado ? 'text-red-500 font-semibold' : 'text-gray-400' %>">
                                <%= atrasado ? '⚠️ Prazo vencido!' : 'Prazo configurado' %>
                            </p>
                            <% } %>
                        </div>
                    </div>

                    <% if(['admin', 'secom', 'super_admin'].includes(user.role)) { %>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Secretaria <span class="text-red-500">*</span></label>
                        <select name="secretaria_id" required
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                            <option value="">Selecione...</option>
                            <% secretarias.forEach(function(s) { %>
                                <option value="<%= s.id %>" <%= sol.secretaria_id == s.id ? 'selected' : '' %>><%= s.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>

                </div>

            </div>

        </div>

        <div class="px-6 py-4 border-t border-gray-100 flex justify-between items-center bg-gray-50 rounded-b-xl">
            <a href="/solicitacoes/<%= sol.id %>" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-600 font-medium hover:bg-white transition text-sm">Cancelar</a>
            <button type="submit"
                class="px-6 py-2.5 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-sm inline-flex items-center gap-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Salvar Alterações
            </button>
        </div>
    </form>

    <!-- Toast -->
    <div x-show="toast !== ''"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white"
        :class="toastOk ? 'bg-green-600' : 'bg-red-600'"
        x-text="toast">
    </div>
</div>
