<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Estúdio de Artes</h1>
            <p class="text-sm text-gray-500 mt-0.5">Monte artes institucionais a partir de modelos com identidade visual consistente.</p>
        </div>
        <a href="/artes/producao" class="c-btn c-btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Nova arte
        </a>
    </div>

    <% if (podeAdministrar) { %>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a href="/artes/modelos" class="c-card c-card-hover p-4 flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">◆</span>
            <span class="text-sm font-semibold text-gray-800">Modelos</span>
        </a>
        <a href="/artes/ativos" class="c-card c-card-hover p-4 flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">▦</span>
            <span class="text-sm font-semibold text-gray-800">Elementos</span>
        </a>
        <a href="/artes/paletas" class="c-card c-card-hover p-4 flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">◑</span>
            <span class="text-sm font-semibold text-gray-800">Paletas e estilos</span>
        </a>
        <a href="/biblioteca" class="c-card c-card-hover p-4 flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">▤</span>
            <span class="text-sm font-semibold text-gray-800">Biblioteca de Artes</span>
        </a>
    </div>
    <% } %>

    <% if (solicitacoesPendentes && solicitacoesPendentes.length) { %>
    <section class="c-card p-5">
        <h2 class="text-sm font-bold text-gray-800 mb-3">Solicitações aguardando produção</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <% solicitacoesPendentes.forEach(function(s){ %>
            <a href="/artes/producao?solicitacao_id=<%= s.id %>" class="border border-gray-100 rounded-lg p-3 hover:border-blue-200 hover:bg-blue-50/40 transition block">
                <p class="text-sm font-semibold text-gray-800 line-clamp-2"><%= s.titulo %></p>
                <div class="flex items-center gap-2 mt-2">
                    <span class="c-badge c-badge-neutral"><%= s.tipo_midia %></span>
                    <% if (s.secretaria) { %><span class="text-[11px] text-gray-400 truncate"><%= s.secretaria.nome %></span><% } %>
                </div>
            </a>
            <% }); %>
        </div>
    </section>
    <% } %>

    <section>
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold text-gray-800">Modelos disponíveis</h2>
            <% if (podeAdministrar) { %><a href="/artes/modelos" class="text-xs font-semibold text-blue-600 hover:underline">Gerenciar modelos</a><% } %>
        </div>
        <% if (!templates.length) { %>
        <div class="c-card p-8 text-center text-sm text-gray-400">
            Nenhum modelo publicado ainda.
            <% if (podeAdministrar) { %> <a href="/artes/modelos/novo" class="text-blue-600 font-semibold hover:underline">Criar o primeiro modelo</a>.<% } %>
        </div>
        <% } else { %>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <% templates.forEach(function(t){ var v = (t.variantes||[])[0]; %>
            <a href="/artes/producao?template_id=<%= t.id %>" class="c-card c-card-hover overflow-hidden block">
                <div class="bg-slate-100 h-44 flex items-center justify-center overflow-hidden">
                    <% if (v) { %>
                    <img src="/artes/modelos/<%= t.id %>/thumb/<%= v.chave %>" alt="<%= t.nome %>" class="max-h-full max-w-full object-contain" loading="lazy">
                    <% } %>
                </div>
                <div class="p-3">
                    <p class="text-sm font-semibold text-gray-800 truncate"><%= t.nome %></p>
                    <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                        <span class="c-badge c-badge-neutral"><%= t.categoria %></span>
                        <% JSON.parse(t.formatos||'[]').forEach(function(f){ %><span class="c-badge c-badge-primary"><%= f %></span><% }); %>
                        <% if (t.carrossel) { %><span class="c-badge c-badge-success">carrossel</span><% } %>
                    </div>
                </div>
            </a>
            <% }); %>
        </div>
        <% } %>
    </section>

    <% if (geracoes && geracoes.length) { %>
    <section>
        <h2 class="text-sm font-bold text-gray-800 mb-3">Artes recentes</h2>
        <div class="c-card divide-y divide-gray-100">
            <% geracoes.forEach(function(g){ %>
            <a href="/artes/geracoes/<%= g.id %>" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50 transition">
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-gray-800 truncate"><%= g.titulo || ('Arte #' + g.id) %></p>
                    <p class="text-[11px] text-gray-400"><%= g.template ? g.template.nome : '' %> · <%= new Date(g.updatedAt).toLocaleString('pt-BR') %></p>
                </div>
                <span class="c-badge <%= g.estado === 'aprovado' ? 'c-badge-success' : g.estado === 'gerado' ? 'c-badge-primary' : 'c-badge-neutral' %>"><%= g.estado %></span>
            </a>
            <% }); %>
        </div>
    </section>
    <% } %>
</div>
