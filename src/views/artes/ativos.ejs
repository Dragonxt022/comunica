<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Biblioteca de elementos</h1>
            <p class="text-sm text-gray-500 mt-0.5">Imagens, ícones, fundos e formas reutilizáveis pelos modelos.</p>
        </div>
        <a href="/artes" class="c-btn c-btn-secondary">Voltar ao Estúdio</a>
    </div>

    <% if (ok) { %><div class="c-card p-3 text-sm text-emerald-700 bg-emerald-50 border-emerald-100">Alterações salvas.</div><% } %>

    <div class="grid lg:grid-cols-[360px_1fr] gap-6">
        <form action="/artes/ativos" method="POST" enctype="multipart/form-data" class="c-card p-5 space-y-3 h-fit">
            <h2 class="text-sm font-bold text-gray-800">Enviar elemento</h2>
            <div><label class="c-label">Arquivo (imagem/SVG)</label><input type="file" name="imagem" accept="image/*" required></div>
            <div><label class="c-label">Nome</label><input class="c-input" name="nome" required></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="c-label">Categoria</label><input class="c-input" name="categoria" value="Geral" list="cats">
                    <datalist id="cats"><% categorias.forEach(function(c){ %><option value="<%= c %>"><% }); %></datalist>
                </div>
                <div><label class="c-label">Tipo</label><select class="c-select" name="tipo">
                    <option value="imagem">Imagem</option><option value="fundo">Fundo</option><option value="icone">Ícone</option>
                    <option value="forma">Forma</option><option value="textura">Textura</option><option value="componente">Componente</option>
                </select></div>
            </div>
            <div><label class="c-label">Descrição</label><input class="c-input" name="descricao"></div>
            <div><label class="c-label">Tags (separadas por vírgula)</label><input class="c-input" name="tags"></div>
            <div><label class="c-label">Texto alternativo</label><input class="c-input" name="alt"></div>
            <label class="flex items-center gap-2 text-sm text-gray-600"><input type="checkbox" name="uso_institucional"> Uso institucional</label>
            <button class="c-btn c-btn-primary w-full">Enviar elemento</button>
        </form>

        <div class="space-y-4">
            <form method="GET" action="/artes/ativos" class="flex flex-wrap gap-2">
                <input class="c-input" style="max-width:220px" name="q" value="<%= filtros.q %>" placeholder="Buscar por nome...">
                <select class="c-select" style="max-width:200px" name="categoria" onchange="this.form.submit()">
                    <option value="">Todas as categorias</option>
                    <% categorias.forEach(function(c){ %><option value="<%= c %>" <%= filtros.categoria===c?'selected':'' %>><%= c %></option><% }); %>
                </select>
                <button class="c-btn c-btn-secondary">Filtrar</button>
            </form>

            <% if (!ativos.length) { %>
            <div class="c-card p-8 text-center text-sm text-gray-400">Nenhum elemento cadastrado.</div>
            <% } else { %>
            <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
                <% ativos.forEach(function(a){ %>
                <div class="c-card overflow-hidden">
                    <div class="h-32 bg-slate-100 flex items-center justify-center overflow-hidden">
                        <% if (a.url) { %><img src="<%= a.url %>" alt="<%= a.alt || a.nome %>" class="max-h-full max-w-full object-contain" loading="lazy"><% } else { %><span class="text-xs text-gray-400">sem arquivo</span><% } %>
                    </div>
                    <div class="p-3 space-y-1.5">
                        <p class="text-sm font-semibold text-gray-800 truncate"><%= a.nome %></p>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="c-badge c-badge-neutral"><%= a.categoria %></span>
                            <span class="c-badge c-badge-primary"><%= a.tipo %></span>
                            <% if (a.uso_institucional) { %><span class="c-badge c-badge-warning">institucional</span><% } %>
                        </div>
                        <form action="/artes/ativos/<%= a.id %>/arquivar" method="POST">
                            <button class="c-btn c-btn-ghost c-btn-sm"><%= a.estado === 'arquivado' ? 'Reativar' : 'Arquivar' %></button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</div>
