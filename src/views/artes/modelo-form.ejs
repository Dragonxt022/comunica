    }
    renderCanvas(); renderProps(); renderLayers();

    var grabbedEl = varAtual().elementos.find(function(x){ return x.id === id; });
    if (grabbedEl && grabbedEl.bloqueado) { e.preventDefault(); return; }
    var v2 = varAtual(); var orig = {};
    state.sel.forEach(function(sid){ var en = v2.elementos.find(function(x){ return x.id === sid; }); if (en) orig[sid] = JSON.parse(JSON.stringify(en)); });
    drag = { mode:'move', id:id, ids: state.sel.slice(), orig:orig, sx:e.clientX, sy:e.clientY, scale:s };
    e.preventDefault();
  });

  window.addEventListener('pointermove', function(e){
    if (!drag) return;
    var v = varAtual();

    if (drag.mode === 'marquee') {
      var rect = canvas.getBoundingClientRect();
      var cx = (e.clientX - rect.left) / drag.scale, cy = (e.clientY - rect.top) / drag.scale;
      var l = Math.min(drag.sx, cx), t = Math.min(drag.sy, cy), w = Math.abs(cx - drag.sx), h = Math.abs(cy - drag.sy);
      marquee.style.left = l + 'px'; marquee.style.top = t + 'px'; marquee.style.width = w + 'px'; marquee.style.height = h + 'px';
      drag.dentro = selIntersectando(l, t, w, h);
      var dentro = drag.dentro;
      inner.querySelectorAll('.ed-el').forEach(function(div){ div.classList.toggle('sel', dentro.indexOf(div.dataset.id) >= 0); });
      return;
    }

    var dx = (e.clientX - drag.sx) / drag.scale, dy = (e.clientY - drag.sy) / drag.scale;

    if (drag.mode === 'move') {
      var grabbed = drag.orig[drag.id];
      var fdx = dx, fdy = dy;
      if (grabbed && (grabbed.tipo === 'retangulo' || grabbed.tipo === 'imagem' || grabbed.tipo === 'texto')) {
        var w0 = grabbed.w || 0, h0 = grabbed.h || 0, tol = 10 / drag.scale;
        var sxv = snapEixo(grabbed.x + dx, w0, v.largura, tol);
        var syv = snapEixo(grabbed.y + dy, h0, v.altura, tol);
        fdx = sxv.novaEsq - grabbed.x; fdy = syv.novaEsq - grabbed.y;
        var guias = []; if (sxv.guia !== null) guias.push({ axis:'v', pos:sxv.guia }); if (syv.guia !== null) guias.push({ axis:'h', pos:syv.guia });
        aplicarGuias(guias);
      } else { limparGuias(); }
      drag.ids.forEach(function(sid){
        var en = v.elementos.find(function(x){ return x.id === sid; }); var o = drag.orig[sid]; if (!en || !o || en.bloqueado) return;
        if (en.tipo === 'circulo') { en.cx = Math.round(o.cx + fdx); en.cy = Math.round(o.cy + fdy); }
        else if (en.tipo === 'linha') { en.x1 = Math.round(o.x1 + fdx); en.y1 = Math.round(o.y1 + fdy); en.x2 = Math.round(o.x2 + fdx); en.y2 = Math.round(o.y2 + fdy); }
        else { en.x = Math.round(o.x + fdx); en.y = Math.round(o.y + fdy); }
