      var rect = canvas.getBoundingClientRect();
      var cx0 = (e.clientX - rect.left) / s, cy0 = (e.clientY - rect.top) / s;
      drag = { mode:'marquee', sx:cx0, sy:cy0, scale:s, base: state.sel.slice(), dentro: [] };
