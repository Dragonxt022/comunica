<%
  var __tpl = template;
  var __isEditar = modo === 'editar';
  var action = __isEditar ? ('/artes/modelos/' + __tpl.id) : '/artes/modelos';
%>
<style>
  #ed-canvas-wrap { position: relative; background: #eef2f6; border-radius: 12px; overflow: auto; height: 78vh; max-height: 860px; }
  #ed-canvas { position: absolute; top: 0; left: 0; background: #fff; box-shadow: 0 4px 24px rgba(15,23,42,.12); transform-origin: top left; }
  .ed-el { position: absolute; cursor: move; box-sizing: border-box; }
  .ed-el.sel { outline: 2px solid #2563eb; outline-offset: 0; }
  .ed-el .ed-handle { position: absolute; width: 12px; height: 12px; background: #fff; border: 2px solid #2563eb; border-radius: 2px; display: none; }
  .ed-el.sel .ed-handle { display: block; }
  .ed-el.locked { cursor: default; }
  .ed-panel { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; }
  .ed-tab { padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; }
  .ed-tab.active { background: #2563eb; color: #fff; }
  .ed-tab:not(.active) { background: #f1f5f9; color: #475569; }
  .ed-field label { display:block; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px; }
  .ed-field input, .ed-field select, .ed-field textarea { width:100%; padding:6px 10px; font-size:13px; border:1px solid #cbd5e1; border-radius:8px; }
  #ed-guides { position:absolute; inset:0; pointer-events:none; z-index:5; }
  .ed-guide-v { position:absolute; top:0; bottom:0; width:1px; background:#ec4899; }
  .ed-guide-h { position:absolute; left:0; right:0; height:1px; background:#ec4899; }
  /* Barra de ferramentas (rail) */
  .ed-rail { display:flex; flex-direction:column; gap:3px; padding:6px 0; align-items:center; }
  .ed-rail button { width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:9px; color:#475569; }
  .ed-rail button:hover { background:#f1f5f9; color:#0f172a; }
  .ed-rail button.active { background:#2563eb; color:#fff; }
  .ed-rail .ed-rail-sep { width:22px; height:1px; background:#e2e8f0; margin:4px 0; }
  .ed-ico { width:18px; height:18px; }
  /* Acordeão de seções */
  .ed-sec-head { display:flex; align-items:center; gap:8px; padding:10px 12px; cursor:pointer; font-size:12px; font-weight:700; color:#334155; user-select:none; }
  .ed-sec-head .ed-chev { margin-left:auto; transition: transform .15s; color:#94a3b8; }
  .ed-sec.collapsed .ed-chev { transform: rotate(-90deg); }
  .ed-sec.collapsed .ed-sec-body { display:none; }
  .ed-sec-body { padding:0 12px 12px; }
  /* Camadas */
  .ed-layer { display:flex; align-items:center; gap:6px; padding:5px 8px; border-radius:8px; font-size:12px; color:#334155; cursor:pointer; border:1px solid transparent; }
  .ed-layer:hover { background:#f8fafc; }
  .ed-layer.active { background:#eff6ff; border-color:#bfdbfe; }
  .ed-layer.drop-before { box-shadow: inset 0 2px 0 #2563eb; }
  .ed-layer.drop-after { box-shadow: inset 0 -2px 0 #2563eb; }
  .ed-layer.dragging { opacity:.5; }
  .ed-drag { cursor:grab; color:#cbd5e1; flex:none; }
  .ed-drag:active { cursor:grabbing; }
  .ed-layer-name { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .ed-layer-btn { width:24px; height:24px; display:flex; align-items:center; justify-content:center; border-radius:6px; color:#94a3b8; flex:none; }
  .ed-layer-btn:hover { background:#f1f5f9; color:#334155; }
  .ed-layer-btn.off { color:#cbd5e1; }
  .ed-layer-btn.on { color:#dc2626; }
  /* Menu de contexto (clique direito) */
  .ed-ctx { position:fixed; z-index:95; background:#fff; border:1px solid #e2e8f0; border-radius:10px; box-shadow:0 12px 34px rgba(15,23,42,.18); padding:4px; min-width:200px; display:none; }
  .ed-ctx.open { display:block; }
  .ed-ctx button { display:flex; align-items:center; gap:8px; width:100%; text-align:left; padding:7px 10px; border-radius:7px; font-size:12px; color:#334155; }
  .ed-ctx button:hover { background:#f1f5f9; }
  .ed-ctx button.danger { color:#dc2626; }
  .ed-ctx .sep { height:1px; background:#e2e8f0; margin:4px 2px; }
  /* Seletor de elementos (biblioteca) */
  .ed-modal { position:fixed; inset:0; z-index:96; background:rgba(15,23,42,.5); display:none; align-items:flex-start; justify-content:center; padding:40px 16px; overflow:auto; }
  .ed-modal.open { display:flex; }
  .ed-ativos-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(110px,1fr)); gap:10px; }
  .ed-ativo-card { border:1px solid #e2e8f0; border-radius:10px; overflow:hidden; cursor:pointer; background:#fff; }
  .ed-ativo-card:hover { border-color:#2563eb; box-shadow:0 4px 12px rgba(37,99,235,.15); }
  .ed-ativo-card img { width:100%; height:84px; object-fit:contain; display:block; background:#f1f5f9; }
  .ed-ativo-card span { display:block; font-size:11px; padding:4px 6px; color:#475569; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ed-img-thumb { width:100%; height:70px; object-fit:contain; background:#f1f5f9; border:1px solid #e2e8f0; border-radius:8px; }
  @media (min-width: 1280px) {
    .ed-rail { position: sticky; top: 1rem; align-self: start; }
    .ed-col-canvas { position: sticky; top: 1rem; align-self: start; }
    .ed-col-props  { position: sticky; top: 1rem; align-self: start; max-height: calc(100vh - 6rem); overflow: auto; }
  }
</style>

<div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <a href="/artes/modelos" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition" title="Voltar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </a>
            <div>
                <h1 class="text-lg font-bold text-gray-900"><%= __isEditar ? 'Editar modelo' : 'Novo modelo' %></h1>
                <p class="text-xs text-gray-500">Monte o layout, defina campos dinâmicos e publique quando estiver pronto.</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <% if (__isEditar) { %><button type="button" id="btn-excluir-modelo" class="c-btn c-btn-ghost text-red-600">Excluir modelo</button><% } %>
            <button type="button" id="btn-salvar" class="c-btn c-btn-primary">Salvar</button>
        </div>
    </div>

    <form id="form-modelo" method="POST" action="<%= action %>" class="grid grid-cols-1 xl:grid-cols-[52px_250px_1fr_320px] gap-3 items-start">
        <input type="hidden" name="variantes_json" id="variantes_json">
        <input type="hidden" name="campos_json" id="campos_json">

        <!-- Barra de ferramentas -->
        <div class="ed-panel ed-rail">
            <button type="button" id="tool-select" class="active" title="Selecionar (V)">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linejoin="round" d="M4 3l7.5 17 2.4-6.6L20.5 11z"/></svg>
            </button>
            <button type="button" data-add="retangulo" title="Retângulo">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/></svg>
            </button>
            <button type="button" data-add="circulo" title="Elipse">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
            </button>
            <button type="button" data-add="linha" title="Linha">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M5 19L19 5"/></svg>
            </button>
            <button type="button" data-add="texto" title="Texto">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6h12M12 6v13"/></svg>
            </button>
            <button type="button" data-add="imagem" title="Imagem">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path stroke-linecap="round" d="M4 16l4-4 5 5 3-3 4 4"/></svg>
            </button>
            <button type="button" id="btn-upload-img" title="Enviar imagem">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M5 20h14"/></svg>
            </button>
            <input type="file" id="ed-upload-input" accept="image/*" class="hidden">
            <div class="ed-rail-sep"></div>
            <button type="button" id="btn-biblioteca" title="Adicionar da biblioteca de elementos">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </button>
            <div class="ed-rail-sep"></div>
            <button type="button" id="btn-undo" title="Desfazer (Ctrl+Z)">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7L4 12l5 5M4 12h11a5 5 0 010 10h-3"/></svg>
            </button>
            <button type="button" id="btn-redo" title="Refazer (Ctrl+Y)">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7l5 5-5 5M20 12H9a5 5 0 000 10h3"/></svg>
            </button>
            <div class="ed-rail-sep"></div>
            <button type="button" id="btn-copiar" title="Copiar (Ctrl+C)">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>
            </button>
            <button type="button" id="btn-duplicar" title="Duplicar (Ctrl+D)">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="12" height="12" rx="2"/><path stroke-linecap="round" d="M12 19h6a2 2 0 002-2v-6"/></svg>
            </button>
            <button type="button" id="btn-excluir" title="Excluir (Delete)" style="color:#dc2626">
                <svg class="ed-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m-1 0v12a2 2 0 01-2 2h-4a2 2 0 01-2-2V7"/></svg>
            </button>
        </div>

        <!-- Painéis (acordeão) -->
        <div class="space-y-3">
            <section class="ed-panel ed-sec collapsed" data-sec="modelo">
                <header class="ed-sec-head">
                    <svg class="ed-ico text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 00-.1-1.2l2-1.6-2-3.4-2.4 1a7 7 0 00-2-1.2l-.4-2.6h-4l-.4 2.6a7 7 0 00-2 1.2l-2.4-1-2 3.4 2 1.6A7 7 0 007 12a7 7 0 00.1 1.2l-2 1.6 2 3.4 2.4-1a7 7 0 002 1.2l.4 2.6h4l.4-2.6a7 7 0 002-1.2l2.4 1 2-3.4-2-1.6A7 7 0 0019 12z"/></svg>
                    Modelo
                    <svg class="ed-ico ed-chev" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
                </header>
                <div class="ed-sec-body space-y-3">
                    <div class="ed-field"><label>Nome do modelo</label><input name="nome" id="f-nome" value="<%= __tpl ? __tpl.nome : '' %>" required></div>
                    <div class="ed-field"><label>Categoria</label><input name="categoria" id="f-categoria" value="<%= __tpl ? __tpl.categoria : 'Institucional' %>"></div>
                    <div class="ed-field"><label>Descrição</label><textarea name="descricao" rows="2"><%= __tpl ? (__tpl.descricao || '') : '' %></textarea></div>
                    <div class="ed-field">
                        <label>Paleta</label>
                        <select name="paleta_id" id="f-paleta">
                            <option value="">Paleta padrão</option>
                            <% paletas.forEach(function(p){ %>
                            <option value="<%= p.id %>" <%= __tpl && __tpl.paleta_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
            </section>

            <section class="ed-panel ed-sec" data-sec="variantes">
                <header class="ed-sec-head">
                    <svg class="ed-ico text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg>
                    Variantes e fundo
                    <svg class="ed-ico ed-chev" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
                </header>
                <div class="ed-sec-body">
                    <div id="ed-tabs" class="flex flex-wrap gap-1.5 mb-3"></div>
                    <div class="flex gap-2 mb-3">
                        <button type="button" id="btn-add-var" class="c-btn c-btn-secondary c-btn-sm">+ Variante</button>
                        <button type="button" id="btn-del-var" class="c-btn c-btn-ghost c-btn-sm text-red-500">Remover</button>
                    </div>
                    <div class="ed-field">
                        <label>Cor de fundo</label>
                        <div style="display:flex;gap:6px">
                            <select id="ed-fundo-select">
                                <% Object.keys((typeof paletaCores !== 'undefined' && paletaCores) ? paletaCores : {}).forEach(function(k){ %><option value="<%= k %>"><%= k %></option><% }); %>
                                <option value="#FFFFFF">branco</option>
                            </select>
                            <input type="color" id="ed-fundo-color" value="#FFFFFF" style="width:40px;padding:2px">
                        </div>
                    </div>
                </div>
            </section>

            <section class="ed-panel ed-sec" data-sec="camadas">
                <header class="ed-sec-head">
                    <svg class="ed-ico text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linejoin="round" d="M12 3l9 5-9 5-9-5 9-5z"/><path stroke-linejoin="round" d="M3 13l9 5 9-5"/></svg>
                    Camadas
                    <svg class="ed-ico ed-chev" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
                </header>
                <div class="ed-sec-body">
                    <p class="text-[10px] text-gray-400 mb-2">Arraste para reordenar. Use o olho e o cadeado por camada.</p>
                    <div id="ed-layers" class="space-y-1"></div>
                </div>
            </section>

            <section class="ed-panel ed-sec collapsed" data-sec="campos">
                <header class="ed-sec-head">
                    <svg class="ed-ico text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"/></svg>
                    Campos dinâmicos
                    <svg class="ed-ico ed-chev" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
                </header>
                <div class="ed-sec-body">
                    <div id="ed-campos" class="space-y-2 mb-2"></div>
                    <button type="button" id="btn-add-campo" class="c-btn c-btn-secondary c-btn-sm w-full">+ campo</button>
                </div>
            </section>
        </div>

        <!-- Canvas -->
        <div class="space-y-2 ed-col-canvas">
            <div id="ed-canvas-wrap" class="p-4">
                <div id="ed-canvas-spacer" style="position: relative;">
                    <div id="ed-canvas"><div id="ed-canvas-inner"></div><div id="ed-guides"></div></div>
                </div>
            </div>
            <p class="text-[11px] text-gray-400">Arraste para mover; use as alças para redimensionar. <b>Shift+clique</b> ou <b>arraste na área vazia</b> seleciona vários (mover em grupo/alinhar). <b>Ctrl+C/V</b> copia/cola, <b>Ctrl+A</b> seleciona tudo, <b>Ctrl+D</b> duplica, <b>Delete</b> exclui.</p>
        </div>

        <!-- Propriedades -->
        <div class="ed-panel p-4 ed-col-props">
            <p class="text-xs font-bold text-gray-700 mb-3">Propriedades</p>
            <div id="ed-props" class="space-y-3 text-sm text-gray-500">Selecione um elemento.</div>
        </div>
    </form>

    <!-- Menu de contexto -->
    <div id="ed-ctx" class="ed-ctx"></div>

    <!-- Seletor de elementos (biblioteca de ativos) -->
    <div id="ed-ativos-modal" class="ed-modal">
        <div class="c-card p-5 w-full max-w-2xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-gray-800" id="ed-ativos-titulo">Biblioteca de elementos</h3>
                <button type="button" class="text-gray-400 hover:text-gray-600" id="ed-ativos-fechar">✕</button>
            </div>
            <input type="text" id="ed-ativos-busca" class="c-input mb-3" placeholder="Buscar por nome, categoria ou tag...">
            <div id="ed-ativos-grid" class="ed-ativos-grid"></div>
            <p id="ed-ativos-vazio" class="text-xs text-gray-400 hidden mt-3">Nenhum elemento encontrado. Envie imagens em Estúdio → Elementos.</p>
        </div>
    </div>
</div>

<script>
(function(){
  var VAR_INICIAL = <%- variantesJson %>;
  var MODELO_ID = <%- __tpl ? __tpl.id : 'null' %>;
  var CAMPOS_INICIAL = <%- __tpl ? (__tpl.campos || '[]') : '[]' %>;
  var SVG_ESTILOS = <%- JSON.stringify(typeof estilos !== 'undefined' && estilos ? estilos : []) %>;
  var ATIVOS = [];

  var state = { variantes: VAR_INICIAL.map(function(v){ return { id:v.id, chave:v.chave, papel:v.papel, nome:v.nome, largura:v.largura, altura:v.altura, fundo:v.fundo, elementos:(v.elementos||[]).slice() }; }), atual:0, sel:[], campos: Array.isArray(CAMPOS_INICIAL) ? CAMPOS_INICIAL : [] };
  if (!state.variantes.length) state.variantes.push({ chave:'9:16', papel:'principal', nome:'Vertical 9:16', largura:1080, altura:1920, elementos:[] });

  var wrap = document.getElementById('ed-canvas-wrap');
  var canvas = document.getElementById('ed-canvas');
  var spacer = document.getElementById('ed-canvas-spacer');
  var inner = document.getElementById('ed-canvas-inner');
  var tabsEl = document.getElementById('ed-tabs');
  var propsEl = document.getElementById('ed-props');
  var camposEl = document.getElementById('ed-campos');

  function varAtual(){ return state.variantes[state.atual]; }
  function selId(){ return state.sel.length ? state.sel[state.sel.length - 1] : null; }
  function selEl(){ var v = varAtual(); var id = selId(); return id ? (v.elementos.find(function(e){ return e.id === id; }) || null) : null; }
  function selEls(){ var v = varAtual(); return v.elementos.filter(function(e){ return state.sel.indexOf(e.id) >= 0; }); }
  function bounds(el){ if (el.tipo==='circulo') return { l:el.cx-el.r, t:el.cy-el.r, w:el.r*2, h:el.r*2 }; if (el.tipo==='linha') return { l:Math.min(el.x1,el.x2), t:Math.min(el.y1,el.y2), w:Math.abs(el.x2-el.x1), h:Math.abs(el.y2-el.y1) }; if (el.tipo==='texto') return { l:el.x, t:el.y, w:el.w, h:0 }; return { l:el.x, t:el.y, w:el.w, h:el.h }; }
  function moverEl(el, dl, dt){ if (el.tipo==='circulo'){ el.cx += dl; el.cy += dt; } else if (el.tipo==='linha'){ el.x1 += dl; el.y1 += dt; el.x2 += dl; el.y2 += dt; } else { el.x += dl; el.y += dt; } }
  function rotuloDe(chave){ return String(chave).replace(/[_-]+/g,' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); }).trim(); }
  function chavesDoLayout(){
    var set = {};
    varAtual().elementos.forEach(function(el){
      if (el.tipo !== 'texto') return;
      if (el.variavel) set[el.variavel] = 1;
      (String(el.valor || '').match(/\{\{\s*[\w.]+\s*\}\}/g) || []).forEach(function(m){ set[m.replace(/[{}]|\s/g, '')] = 1; });
    });
    return Object.keys(set);
  }
  // Cria automaticamente um campo para cada {{chave}} usado no layout.
  function derivarCampos(){
    var existentes = {}; state.campos.forEach(function(c){ existentes[c.chave] = 1; });
    var mudou = false;
    chavesDoLayout().forEach(function(k){
      if (!existentes[k]) { state.campos.push({ chave:k, rotulo:rotuloDe(k), tipo:/texto|conteudo|descri|corpo|body/i.test(k) ? 'textarea' : 'texto', obrigatorio:false, __auto:true }); mudou = true; }
    });
    return mudou;
  }
  function dadosAmostra(){ var d={}; state.campos.forEach(function(c){ d[c.chave] = (c.rotulo||c.chave); }); return d; }
  function interpolar(t, d){ return String(t||'').replace(/\{\{\s*([\w.]+)\s*\}\}/g, function(m,k){ return d[k]!==undefined?d[k]:''; }); }
  function uid(){ return 'el-'+Math.random().toString(36).slice(2,9); }
  function proxCamada(){ var v=varAtual(); return v.elementos.reduce(function(m,e){return Math.max(m,e.camada||0);},0)+1; }
  function escala(){ return Math.min((wrap.clientWidth-32)/varAtual().largura, (wrap.clientHeight-32)/varAtual().altura, 1); }
