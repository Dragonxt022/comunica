    var termo = String(q || '').toLowerCase();
    var lista = ATIVOS.filter(function(a){ if(!a.url) return false; if(!termo) return true; return (a.nome+' '+(a.categoria||'')+' '+(a.tags||'')).toLowerCase().indexOf(termo) >= 0; });
    ativosGrid.innerHTML = lista.map(function(a){ return '<div class="ed-ativo-card" data-ativo-url="'+a.url+'" title="'+(a.nome||'')+'"><img src="'+a.url+'" alt=""><span>'+(a.nome||'')+'</span></div>'; }).join('');
    document.getElementById('ed-ativos-vazio').classList.toggle('hidden', lista.length > 0);
  }
  function abrirAtivos(modo){
    ativoModo = modo;
    document.getElementById('ed-ativos-titulo').textContent = modo === 'set' ? 'Escolher imagem' : 'Adicionar da biblioteca';
    document.getElementById('ed-ativos-busca').value = '';
    renderAtivos('');
    ativosModal.classList.add('open');
  }
  function fecharAtivos(){ ativosModal.classList.remove('open'); }
  ativosGrid.addEventListener('click', function(e){
    var card = e.target.closest('[data-ativo-url]'); if(!card) return;
    var url = card.dataset.ativoUrl; var v = varAtual();
    if (ativoModo === 'set') { var el = selEl(); if (el && el.tipo === 'imagem') el.url = url; }
    else { var img = { id:uid(), tipo:'imagem', x:0, y:Math.round(v.altura*0.1), w:v.largura, h:Math.round(v.largura*0.6), ajuste:'cover', raio:0, camada:proxCamada(), opacidade:1, url:url }; v.elementos.push(img); state.sel = [img.id]; }
    pushHistory(); renderAll(); fecharAtivos();
  });
  document.getElementById('ed-ativos-fechar').addEventListener('click', fecharAtivos);
  ativosModal.addEventListener('click', function(e){ if(e.target === ativosModal) fecharAtivos(); });
  document.getElementById('ed-ativos-busca').addEventListener('input', function(){ renderAtivos(this.value); });
  var btnBiblioteca = document.getElementById('btn-biblioteca');
  if (btnBiblioteca) btnBiblioteca.addEventListener('click', function(){ abrirAtivos('add'); });

  // ── Menu de contexto (clique direito) ────────────────────────────────────
  function mostrarCtx(x, y, alvoId){
    var itens = alvoId ? [
      ['Trazer para frente','frente'], ['Enviar para trás','tras'], ['Trazer para o topo','topo'], ['Enviar para o fundo','fundo'],
      ['-'],
      ['Duplicar','dup'], ['Copiar','copy'], ['Colar','colar'],
      ['-'],
      ['Definir como fundo da arte','bg'], ['Bloquear/Desbloquear','lock'], ['Ocultar/Mostrar','hide'],
      ['-'],
      ['Excluir','del','danger'],
    ] : [['Colar','colar']];
    ctxEl.innerHTML = itens.map(function(it){ return it[0] === '-' ? '<div class="sep"></div>' : '<button type="button" data-ctx="'+it[1]+'"'+(it[2]?(' class="'+it[2]+'"'):'')+'>'+it[0]+'</button>'; }).join('');
    ctxEl.dataset.alvo = alvoId || '';
    ctxEl.style.left = Math.min(x, innerWidth - 220) + 'px';
    ctxEl.style.top = Math.min(y, Math.max(8, innerHeight - 340)) + 'px';
    ctxEl.classList.add('open');
  }
  function fecharCtx(){ ctxEl.classList.remove('open'); }
  inner.addEventListener('contextmenu', function(e){
    e.preventDefault();
    var elDiv = e.target.closest('.ed-el'); var alvoId = elDiv ? elDiv.dataset.id : '';
    if (alvoId && state.sel.indexOf(alvoId) < 0) state.sel = [alvoId];
    if (alvoId) { renderCanvas(); renderProps(); renderLayers(); }
    mostrarCtx(e.clientX, e.clientY, alvoId);
  });
  window.addEventListener('pointerdown', function(e){ if(!e.target.closest('#ed-ctx')) fecharCtx(); }, true);
  window.addEventListener('scroll', fecharCtx, true);
  ctxEl.addEventListener('click', function(e){
    var acao = e.target.dataset.ctx; if(!acao) return;
    var v = varAtual(); var el = v.elementos.find(function(x){ return x.id === selId(); });
    if (acao === 'frente' && el) el.camada = (el.camada || 0) + 1;
    else if (acao === 'tras' && el) el.camada = (el.camada || 0) - 1;
    else if (acao === 'topo' && el) el.camada = proxCamada();
    else if (acao === 'fundo' && el) el.camada = -1;
    else if (acao === 'dup') duplicarSelecionado();
    else if (acao === 'copy') copiarSelecionado();
    else if (acao === 'colar') colarSelecionado();
    else if (acao === 'bg' && el) { el.x = 0; el.y = 0; el.w = v.largura; el.h = v.altura; if (el.tipo === 'imagem') el.ajuste = 'cover'; if (el.tipo === 'retangulo') el.raio = 0; el.camada = -1; }
    else if (acao === 'lock' && el) el.bloqueado = !el.bloqueado;
    else if (acao === 'hide' && el) el.oculto = !el.oculto;
    else if (acao === 'del') excluirSelecionado();
    pushHistory(); renderAll(); fecharCtx();
  });

  // campos
  document.getElementById('btn-add-campo').addEventListener('click', function(){ state.campos.push({chave:'campo'+ (state.campos.length+1), rotulo:'Campo '+ (state.campos.length+1), tipo:'texto', obrigatorio:false}); pushHistory(); renderCampos(); });
  camposEl.addEventListener('input', function(e){ var i=e.target.dataset.i; if(i===undefined) return; var c=state.campos[+i]; if(!c) return; var k=e.target.dataset.campo; c[k]= e.target.type==='checkbox'?e.target.checked:e.target.value; if(k==='chave'){ c.__auto=false; renderProps(); } });
  camposEl.addEventListener('click', function(e){ if(e.target.dataset.delCampo!==undefined){ state.campos.splice(+e.target.dataset.delCampo,1); pushHistory(); renderCampos(); } });

  // salvar
  function salvar(){
    document.getElementById('variantes_json').value = JSON.stringify(state.variantes);
    document.getElementById('campos_json').value = JSON.stringify(state.campos);
    document.getElementById('form-modelo').submit();
  }
  document.getElementById('btn-salvar').addEventListener('click', salvar);
  var btnExcluirModelo = document.getElementById('btn-excluir-modelo');
  if (btnExcluirModelo) btnExcluirModelo.addEventListener('click', function(){
    if (!confirm('Excluir este modelo? Modelos com artes geradas precisam ser arquivados.')) return;
    fetch('/artes/modelos/' + MODELO_ID + '/excluir', { method:'POST', headers:{ 'Accept':'application/json' } })
      .then(function(r){ return r.json().then(function(d){ return { ok:r.ok, d:d }; }); })
      .then(function(res){ if (res.ok && res.d.ok) window.location.href = '/artes/modelos?ok=excluido'; else alert((res.d && res.d.error) || 'Não foi possível excluir.'); })
      .catch(function(){ alert('Erro ao excluir.'); });
  });
  document.getElementById('form-modelo').addEventListener('submit', function(){ document.getElementById('variantes_json').value=JSON.stringify(state.variantes); document.getElementById('campos_json').value=JSON.stringify(state.campos); });

  window.addEventListener('resize', renderCanvas);

  fetch('/artes/ativos.json', { headers: { 'Accept':'application/json' } }).then(function(r){return r.json();}).then(function(d){ ATIVOS=d||[]; }).catch(function(){});

  renderAll();
  pushHistory();
})();
</script>
