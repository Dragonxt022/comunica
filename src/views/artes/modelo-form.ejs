    if (modo === 'left') { var minL = Math.min.apply(null, bs.map(function(x){ return x.b.l; })); bs.forEach(function(x){ moverEl(x.en, minL - x.b.l, 0); }); }
    else if (modo === 'right') { var maxR = Math.max.apply(null, bs.map(function(x){ return x.b.l + x.b.w; })); bs.forEach(function(x){ moverEl(x.en, maxR - (x.b.l + x.b.w), 0); }); }
    else if (modo === 'hcenter') { var cs = bs.map(function(x){ return x.b.l + x.b.w/2; }); var alvo = (Math.min.apply(null, cs) + Math.max.apply(null, cs)) / 2; bs.forEach(function(x){ moverEl(x.en, alvo - (x.b.l + x.b.w/2), 0); }); }
    else if (modo === 'top') { var minT = Math.min.apply(null, bs.map(function(x){ return x.b.t; })); bs.forEach(function(x){ moverEl(x.en, 0, minT - x.b.t); }); }
