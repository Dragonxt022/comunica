      var hh = drag.handle; limparGuias();
      if (el.tipo === 'retangulo' || el.tipo === 'imagem') {
        var x = o.x, y = o.y, w = o.w, h2 = o.h;
        if (hh.indexOf('e') >= 0) w = o.w + dx; if (hh.indexOf('s') >= 0) h2 = o.h + dy;
        if (hh.indexOf('w') >= 0) { x = o.x + dx; w = o.w - dx; } if (hh.indexOf('n') >= 0) { y = o.y + dy; h2 = o.h - dy; }
