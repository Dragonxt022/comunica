<%
  var __tpl = template;
  var __isEditar = modo === 'editar';
  var action = __isEditar ? ('/artes/modelos/' + __tpl.id) : '/artes/modelos';
%>
<style>
  #ed-canvas-wrap { position: relative; background: #eef2f6; border-radius: 12px; overflow: auto; height: 78vh; max-height: 860px; }
  #ed-canvas { position: absolute; top: 0; left: 0; background: #fff; box-shadow: 0 4px 24px rgba(15,23,42,.12); transform-origin: top left; }
  .ed-el { position: absolute; cursor: move; box-sizing: border-box; }
  .ed-el.sel { outline: 2px solid #2563eb; outline-offset: 0; }
  .ed-el .ed-handle { position: absolute; width: 12px; height: 12px; background: #fff; border: 2px solid #2563eb; border-radius: 2px; display: none; }
  .ed-el.sel .ed-handle { display: block; }
  .ed-panel { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; }
  .ed-tab { padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; }
  .ed-tab.active { background: #2563eb; color: #fff; }
  .ed-tab:not(.active) { background: #f1f5f9; color: #475569; }
  .ed-field label { display:block; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px; }
  .ed-field input, .ed-field select, .ed-field textarea { width:100%; padding:6px 10px; font-size:13px; border:1px solid #cbd5e1; border-radius:8px; }
  #ed-guides { position:absolute; inset:0; pointer-events:none; z-index:5; }
  .ed-guide-v { position:absolute; top:0; bottom:0; width:1px; background:#ec4899; }
  .ed-guide-h { position:absolute; left:0; right:0; height:1px; background:#ec4899; }
</style>

<div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <a href="/artes/modelos" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </a>
            <div>
                <h1 class="text-lg font-bold text-gray-900"><%= __isEditar ? 'Editar modelo' : 'Novo modelo' %></h1>
                <p class="text-xs text-gray-500">Monte o layout, defina campos dinâmicos e publique quando estiver pronto.</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" id="btn-salvar" class="c-btn c-btn-primary">Salvar</button>
        </div>
    </div>

    <form id="form-modelo" method="POST" action="<%= action %>" class="grid grid-cols-1 xl:grid-cols-[260px_1fr_300px] gap-4">
        <input type="hidden" name="variantes_json" id="variantes_json">
        <input type="hidden" name="campos_json" id="campos_json">

        <!-- Coluna esquerda: metadados + variantes + ferramentas -->
        <div class="space-y-4">
            <div class="ed-panel p-4 space-y-3">
                <div class="ed-field"><label>Nome do modelo</label><input name="nome" id="f-nome" value="<%= __tpl ? __tpl.nome : '' %>" required></div>
                <div class="ed-field"><label>Categoria</label><input name="categoria" id="f-categoria" value="<%= __tpl ? __tpl.categoria : 'Institucional' %>"></div>
                <div class="ed-field"><label>Descrição</label><textarea name="descricao" rows="2"><%= __tpl ? (__tpl.descricao || '') : '' %></textarea></div>
                <div class="ed-field">
                    <label>Paleta</label>
                    <select name="paleta_id" id="f-paleta">
                        <option value="">Paleta padrão</option>
                        <% paletas.forEach(function(p){ %>
                        <option value="<%= p.id %>" <%= __tpl && __tpl.paleta_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <div class="ed-panel p-4">
                <p class="text-xs font-bold text-gray-700 mb-2">Variantes / formatos</p>
                <div id="ed-tabs" class="flex flex-wrap gap-1.5 mb-3"></div>
                <div class="flex gap-2">
                    <button type="button" id="btn-add-var" class="c-btn c-btn-secondary c-btn-sm">+ Variante</button>
                    <button type="button" id="btn-del-var" class="c-btn c-btn-ghost c-btn-sm text-red-500">Remover</button>
                </div>
            </div>

            <div class="ed-panel p-4">
                <p class="text-xs font-bold text-gray-700 mb-2">Adicionar elemento</p>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" data-add="retangulo">Retângulo</button>
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" data-add="circulo">Círculo</button>
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" data-add="linha">Linha</button>
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" data-add="texto">Texto</button>
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" data-add="imagem">Imagem</button>
                    <button type="button" class="c-btn c-btn-secondary c-btn-sm" id="btn-upload-img">Enviar imagem</button>
                </div>
                <input type="file" id="ed-upload-input" accept="image/*" class="hidden">
                <p class="text-[10px] text-gray-400 mt-2">Dica: clique em "Enviar imagem" para subir um arquivo direto para a biblioteca e já aplicá-lo ao elemento selecionado.</p>
            </div>

            <div class="ed-panel p-4">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-xs font-bold text-gray-700">Camadas</p>
                    <div class="flex gap-1">
                        <button type="button" id="btn-undo" class="c-btn c-btn-ghost c-btn-sm" title="Desfazer (Ctrl+Z)">↶</button>
                        <button type="button" id="btn-redo" class="c-btn c-btn-ghost c-btn-sm" title="Refazer (Ctrl+Y)">↷</button>
                    </div>
                </div>
                <div id="ed-layers" class="space-y-1"></div>
            </div>

            <div class="ed-panel p-4">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-xs font-bold text-gray-700">Campos dinâmicos</p>
                    <button type="button" id="btn-add-campo" class="text-xs text-blue-600 font-semibold">+ campo</button>
                </div>
                <div id="ed-campos" class="space-y-2"></div>
            </div>
        </div>

        <!-- Canvas -->
        <div class="space-y-2">
            <div id="ed-canvas-wrap" class="p-4">
                <div id="ed-canvas-spacer" style="position: relative;">
                    <div id="ed-canvas"><div id="ed-canvas-inner"></div><div id="ed-guides"></div></div>
                </div>
            </div>
            <p class="text-[11px] text-gray-400">Arraste para mover; use as alças para redimensionar. <b>Ctrl+C/Ctrl+V</b> copia e cola, <b>Ctrl+D</b> duplica, <b>Delete</b> exclui. As coordenadas são em pixels do formato final.</p>
        </div>

        <!-- Propriedades -->
        <div class="ed-panel p-4">
            <p class="text-xs font-bold text-gray-700 mb-3">Propriedades</p>
            <div id="ed-props" class="space-y-3 text-sm text-gray-500">Selecione um elemento.</div>
        </div>
    </form>
</div>

<script>
(function(){
  var VAR_INICIAL = <%- variantesJson %>;
  var CAMPOS_INICIAL = <%- __tpl ? (__tpl.campos || '[]') : '[]' %>;
  var SVG_ESTILOS = <%- JSON.stringify(typeof estilos !== 'undefined' && estilos ? estilos : []) %>;
  var ATIVOS = [];

  var state = { variantes: VAR_INICIAL.map(function(v){ return { id:v.id, chave:v.chave, papel:v.papel, nome:v.nome, largura:v.largura, altura:v.altura, elementos:(v.elementos||[]).slice() }; }), atual:0, sel:null, campos: Array.isArray(CAMPOS_INICIAL) ? CAMPOS_INICIAL : [] };
  if (!state.variantes.length) state.variantes.push({ chave:'9:16', papel:'principal', nome:'Vertical 9:16', largura:1080, altura:1920, elementos:[] });

  var wrap = document.getElementById('ed-canvas-wrap');
  var canvas = document.getElementById('ed-canvas');
  var spacer = document.getElementById('ed-canvas-spacer');
  var inner = document.getElementById('ed-canvas-inner');
  var tabsEl = document.getElementById('ed-tabs');
  var propsEl = document.getElementById('ed-props');
  var camposEl = document.getElementById('ed-campos');

  function varAtual(){ return state.variantes[state.atual]; }
  function dadosAmostra(){ var d={}; state.campos.forEach(function(c){ d[c.chave] = (c.rotulo||c.chave); }); return d; }
  function interpolar(t, d){ return String(t||'').replace(/\{\{\s*([\w.]+)\s*\}\}/g, function(m,k){ return d[k]!==undefined?d[k]:''; }); }
  function uid(){ return 'el-'+Math.random().toString(36).slice(2,9); }
  function proxCamada(){ var v=varAtual(); return v.elementos.reduce(function(m,e){return Math.max(m,e.camada||0);},0)+1; }
  function escala(){ return Math.min((wrap.clientWidth-32)/varAtual().largura, (wrap.clientHeight-32)/varAtual().altura, 1); }
  var CORES = { primary:'#17365D', secondary:'#2878B5', accent:'#F2B544', background:'#F3F5F7', surface:'#FFFFFF', text:'#202833', mutedText:'#5B6673', border:'#D8DEE5', success:'#1F9D55', warning:'#D97706', danger:'#DC2626' };
  function cor(c){ if(!c) return '#000'; if(c[0]==='#') return c; return CORES[c]||'#000'; }

  var guidesEl = document.getElementById('ed-guides');
  var layersEl = document.getElementById('ed-layers');
  var uploadInput = document.getElementById('ed-upload-input');

  // ── Histórico (desfazer/refazer) ─────────────────────────────────────────
  var hist = [], histIdx = -1, restoring = false;
  function snapshot(){ return JSON.stringify({ variantes: state.variantes, campos: state.campos, atual: state.atual }); }
  function pushHistory(){ if (restoring) return; var s = snapshot(); if (hist[histIdx] === s) return; hist = hist.slice(0, histIdx + 1); hist.push(s); histIdx = hist.length - 1; if (hist.length > 60) { hist.shift(); histIdx--; } }
  function restore(s){ restoring = true; var o = JSON.parse(s); state.variantes = o.variantes; state.campos = o.campos; state.atual = o.atual || 0; state.sel = null; renderAll(); restoring = false; }
  document.getElementById('btn-undo').addEventListener('click', function(){ if (histIdx > 0) { histIdx--; restore(hist[histIdx]); } });
  document.getElementById('btn-redo').addEventListener('click', function(){ if (histIdx < hist.length - 1) { histIdx++; restore(hist[histIdx]); } });

  // ── Copiar / colar / duplicar / excluir ──────────────────────────────────
  var clipboard = null;
  function estaDigitando(){ var a = document.activeElement; return !!a && (/^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName) || a.isContentEditable); }
  function copiarSelecionado(){ if (!state.sel) return; var el = varAtual().elementos.find(function(x){ return x.id === state.sel; }); if (!el) return; clipboard = JSON.parse(JSON.stringify(el)); }
  function colarSelecionado(){
    if (!clipboard) return;
    var v = varAtual(); var el = JSON.parse(JSON.stringify(clipboard));
    el.id = uid(); el.camada = proxCamada();
    if (el.x != null) { el.x += 40; el.y += 40; }
    if (el.cx != null) { el.cx += 40; el.cy += 40; }
    if (el.x1 != null) { el.x1 += 40; el.y1 += 40; el.x2 += 40; el.y2 += 40; }
    v.elementos.push(el); state.sel = el.id; pushHistory(); renderAll();
  }
  function duplicarSelecionado(){ copiarSelecionado(); colarSelecionado(); }
  function excluirSelecionado(){ if (!state.sel) return; var v = varAtual(); v.elementos = v.elementos.filter(function(x){ return x.id !== state.sel; }); state.sel = null; pushHistory(); renderAll(); }

  window.addEventListener('keydown', function(e){
    if (estaDigitando()) return;
    var k = e.key.toLowerCase();
    var meta = e.ctrlKey || e.metaKey;
    if (meta && k === 'z') { e.preventDefault(); if (e.shiftKey) { if (histIdx < hist.length - 1) { histIdx++; restore(hist[histIdx]); } } else { if (histIdx > 0) { histIdx--; restore(hist[histIdx]); } } }
    else if (meta && k === 'y') { e.preventDefault(); if (histIdx < hist.length - 1) { histIdx++; restore(hist[histIdx]); } }
    else if (meta && k === 'c') { if (state.sel) { e.preventDefault(); copiarSelecionado(); } }
    else if (meta && k === 'v') { if (clipboard) { e.preventDefault(); colarSelecionado(); } }
    else if (meta && k === 'd') { if (state.sel) { e.preventDefault(); duplicarSelecionado(); } }
    else if (k === 'delete' || k === 'backspace') { if (state.sel) { e.preventDefault(); excluirSelecionado(); } }
  });

  function renderLayers(){
    var v = varAtual();
    var els = v.elementos.slice().sort(function(a,b){ return (b.camada||0) - (a.camada||0); });
    layersEl.innerHTML = els.map(function(e){
      var nome = e.nome || ({ retangulo:'Retângulo', circulo:'Círculo', linha:'Linha', imagem:'Imagem', texto:'Texto' }[e.tipo] || e.tipo);
      return '<div class="flex items-center gap-1 px-2 py-1 rounded cursor-pointer '+(state.sel===e.id?'bg-blue-50':'hover:bg-gray-50')+'" data-layer="'+e.id+'">'
        + '<span class="text-xs text-gray-700 flex-1 truncate">'+nome+(e.bloqueado?' 🔒':'')+'</span>'
        + '<button type="button" class="text-xs text-gray-400 hover:text-gray-700 px-1" data-layer-up="'+e.id+'" title="Trazer para frente">↑</button>'
        + '<button type="button" class="text-xs text-gray-400 hover:text-gray-700 px-1" data-layer-down="'+e.id+'" title="Enviar para trás">↓</button>'
        + '</div>';
    }).join('') || '<p class="text-[11px] text-gray-400">Sem elementos.</p>';
  }
  layersEl.addEventListener('click', function(e){
    var up = e.target.dataset.layerUp, down = e.target.dataset.layerDown, lay = e.target.dataset.layer;
    if (up || down) {
      var el = varAtual().elementos.find(function(x){ return x.id === (up||down); });
      if (el) { el.camada = (el.camada||0) + (up?1:-1); pushHistory(); renderCanvas(); renderLayers(); }
      return;
    }
    if (lay) { state.sel = lay; renderCanvas(); renderProps(); renderLayers(); }
  });

  // ── Upload de imagem direto para a biblioteca ────────────────────────────
  document.getElementById('btn-upload-img').addEventListener('click', function(){ uploadInput.click(); });
  uploadInput.addEventListener('change', function(){
    var f = uploadInput.files[0]; if (!f) return;
    var fd = new FormData(); fd.append('imagem', f); fd.append('nome', f.name); fd.append('tipo','imagem'); fd.append('categoria','Geral');
    fetch('/artes/ativos', { method:'POST', body: fd, headers: { 'Accept':'application/json' } })
      .then(function(r){ return r.json(); }).then(function(d){
        uploadInput.value = '';
        if (!d.ok || !d.ativo) { alert('Falha ao enviar a imagem.'); return; }
        ATIVOS.push({ id:d.ativo.id, nome:d.ativo.nome, tipo:d.ativo.tipo, categoria:d.ativo.categoria, url:d.ativo.url });
        var v = varAtual();
        var sel = v.elementos.find(function(x){ return x.id === state.sel; });
        if (sel && sel.tipo === 'imagem') { sel.url = d.ativo.url; }
        else {
          var el = { id:uid(), tipo:'imagem', x:Math.round(v.largura*0.1), y:Math.round(v.altura*0.1), w:Math.round(v.largura*0.8), h:Math.round(v.largura*0.8), ajuste:'cover', raio:0, camada:proxCamada(), opacidade:1, editavel:true, url:d.ativo.url };
          v.elementos.push(el); state.sel = el.id;
        }
        pushHistory(); renderAll();
      }).catch(function(){ uploadInput.value=''; alert('Falha ao enviar a imagem.'); });
  });

  // ── Guias / snapping ─────────────────────────────────────────────────────
  function limparGuias(){ guidesEl.innerHTML=''; }
  function aplicarGuias(lista){ guidesEl.innerHTML = lista.map(function(g){ return g.axis==='v' ? '<div class="ed-guide-v" style="left:'+g.pos+'px"></div>' : '<div class="ed-guide-h" style="top:'+g.pos+'px"></div>'; }).join(''); }
  function snapEixo(esq, tam, limite, tolerancia){
    var centro = esq + tam/2;
    var alvos = [0, limite/2, limite];
    var arestas = [ {pos:esq, off:0}, {pos:centro, off:tam/2}, {pos:esq+tam, off:tam} ];
    var melhor = null;
    for (var i=0;i<arestas.length;i++) for (var j=0;j<alvos.length;j++){
      var dist = Math.abs(arestas[i].pos - alvos[j]);
      if (dist <= tolerancia && (!melhor || dist < melhor.dist)) melhor = { dist:dist, novaEsq: alvos[j] - arestas[i].off, guia: alvos[j] };
    }
    if (melhor) return melhor; return { novaEsq: esq, guia: null };
  }

  // ── Render ──────────────────────────────────────────────────────────────
  function renderTabs(){
    tabsEl.innerHTML = state.variantes.map(function(v,i){
      return '<span class="ed-tab '+(i===state.atual?'active':'')+'" data-var="'+i+'">'+v.chave+' <span class="opacity-60">'+v.largura+'×'+v.altura+'</span></span>';
    }).join('');
  }
  function renderCanvas(){
    var v = varAtual(); var s = escala();
    canvas.style.width = v.largura+'px'; canvas.style.height = v.altura+'px';
    canvas.style.transform = 'scale('+s+')';
    spacer.style.width = Math.round(v.largura*s)+'px';
    spacer.style.height = Math.round(v.altura*s)+'px';
    inner.innerHTML = '';
    var d = dadosAmostra();
    v.elementos.slice().sort(function(a,b){return (a.camada||0)-(b.camada||0);}).forEach(function(el){
      var div = document.createElement('div');
      div.className = 'ed-el' + (state.sel===el.id?' sel':'');
      div.dataset.id = el.id;
      var st = el.estilo||{};
      if (el.tipo==='retangulo'){ div.style.left=el.x+'px'; div.style.top=el.y+'px'; div.style.width=el.w+'px'; div.style.height=el.h+'px'; div.style.background=cor(el.fill); div.style.opacity=el.opacidade!=null?el.opacidade:1; if(el.raio) div.style.borderRadius=el.raio+'px'; }
      else if (el.tipo==='circulo'){ div.style.left=(el.cx-el.r)+'px'; div.style.top=(el.cy-el.r)+'px'; div.style.width=(el.r*2)+'px'; div.style.height=(el.r*2)+'px'; div.style.background=cor(el.fill); div.style.borderRadius='50%'; }
      else if (el.tipo==='linha'){ var w=Math.abs(el.x2-el.x1), h=Math.abs(el.y2-el.y1); div.style.left=Math.min(el.x1,el.x2)+'px'; div.style.top=(Math.min(el.y1,el.y2)-el.espessura/2)+'px'; div.style.width=Math.max(w,el.espessura)+'px'; div.style.height=el.espessura+'px'; div.style.background=cor(el.cor); }
      else if (el.tipo==='imagem'){ div.style.left=el.x+'px'; div.style.top=el.y+'px'; div.style.width=el.w+'px'; div.style.height=el.h+'px'; if(el.raio) div.style.borderRadius=el.raio+'px'; div.style.background='#e2e8f0'; div.style.overflow='hidden'; if(el.url){ div.style.backgroundImage='url('+el.url+')'; div.style.backgroundSize=el.ajuste==='contain'?'contain':'cover'; div.style.backgroundPosition='center'; div.style.backgroundRepeat='no-repeat'; } }
      else if (el.tipo==='texto'){ div.style.left=el.x+'px'; div.style.top=el.y+'px'; div.style.width=el.w+'px'; div.style.color=cor(el.cor||st.cor||'text'); div.style.fontSize=(st.tamanho||40)+'px'; div.style.fontWeight=st.peso||700; div.style.fontFamily=st.familia||'Arial,sans-serif'; div.style.lineHeight=st.alturaLinha||1.15; div.style.textAlign=st.alinhamento||'left'; div.style.whiteSpace='pre-wrap'; div.textContent=interpolar(el.variavel&&!el.valor?('{{'+el.variavel+'}}'):el.valor, d)||'(vazio)'; }
      // handles
      ['nw','n','ne','e','se','s','sw','w'].forEach(function(h){
        var hd=document.createElement('div'); hd.className='ed-handle'; hd.dataset.handle=h; hd.dataset.id=el.id;
        var pos={nw:[0,0],n:[.5,0],ne:[1,0],e:[1,.5],se:[1,1],s:[.5,1],sw:[0,1],w:[0,.5]}[h];
        hd.style.left='calc('+(pos[0]*100)+'% - 6px)'; hd.style.top='calc('+(pos[1]*100)+'% - 6px)'; hd.style.cursor=h+'-resize';
        div.appendChild(hd);
      });
      inner.appendChild(div);
    });
  }
  function renderProps(){
    var v = varAtual();
    if (!state.sel){ propsEl.innerHTML='Selecione um elemento.'; return; }
    var el = v.elementos.find(function(e){return e.id===state.sel;}); if(!el){ propsEl.innerHTML='—'; return; }
    var html='';
    function f(label,key,val,type){ return '<div class="ed-field"><label>'+label+'</label><input data-prop="'+key+'" type="'+(type||'number')+'" value="'+(val==null?'':val)+'"></div>'; }
    function corField(label,key,val){ return '<div class="ed-field"><label>'+label+'</label><div style="display:flex;gap:6px"><select data-prop="'+key+'" data-cor-old="'+(val==null?'':val)+'">'+Object.keys(CORES).map(function(k){return '<option value="'+k+'" '+(val===k?'selected':'')+'>'+k+'</option>';}).join('')+'</select><input type="color" data-prop-cor="'+key+'" data-cor-old="'+(val==null?'':val)+'" value="'+cor(val)+'" style="width:40px;padding:2px"></div></div>'; }
    var tipos={ retangulo:'Retângulo', circulo:'Círculo', linha:'Linha', imagem:'Imagem', texto:'Texto' };
    html += '<p class="text-xs text-gray-400 uppercase font-semibold">'+tipos[el.tipo]+' · '+el.id+'</p>';
    if (el.tipo==='retangulo'){ html+=f('X','x',el.x)+f('Y','y',el.y)+f('Largura','w',el.w)+f('Altura','h',el.h)+corField('Cor','fill',el.fill)+f('Raio','raio',el.raio)+f('Opacidade','opacidade',el.opacidade!=null?el.opacidade:1,'number'); }
    else if (el.tipo==='circulo'){ html+=f('Centro X','cx',el.cx)+f('Centro Y','cy',el.cy)+f('Raio','r',el.r)+corField('Cor','fill',el.fill); }
    else if (el.tipo==='linha'){ html+=f('X1','x1',el.x1)+f('Y1','y1',el.y1)+f('X2','x2',el.x2)+f('Y2','y2',el.y2)+f('Espessura','espessura',el.espessura)+corField('Cor','cor',el.cor); }
    else if (el.tipo==='imagem'){ html+=f('X','x',el.x)+f('Y','y',el.y)+f('Largura','w',el.w)+f('Altura','h',el.h)+'<div class="ed-field"><label>Ajuste</label><select data-prop="ajuste"><option value="cover" '+(el.ajuste!=='contain'?'selected':'')+'>Preencher (cover)</option><option value="contain" '+(el.ajuste==='contain'?'selected':'')+'>Conter (contain)</option></select></div>'+f('Raio','raio',el.raio)+'<div class="ed-field"><label>Ativo</label><select data-prop="url"><option value="">— vazio —</option>'+ATIVOS.map(function(a){return '<option value="'+a.url+'" '+(el.url===a.url?'selected':'')+'>'+a.nome+'</option>';}).join('')+'</select></div>'; }
    else if (el.tipo==='texto'){ var st=el.estilo||{};
      html+= '<div class="ed-field"><label>Texto (use {{campo}})</label><textarea data-prop="valor" rows="2">'+(el.valor||'')+'</textarea></div>';
      html+= '<div class="ed-field"><label>Vincular campo</label><select data-prop="variavel"><option value="">—</option>'+state.campos.map(function(c){return '<option value="'+c.chave+'" '+(el.variavel===c.chave?'selected':'')+'>'+c.chave+'</option>';}).join('')+'</select></div>';
      html+= f('X','x',el.x)+f('Y','y',el.y)+f('Largura','w',el.w);
      html+= '<div class="ed-field"><label>Estilo base</label><select id="ed-aplicar-estilo"><option value="">— copiar de estilo —</option>'+SVG_ESTILOS.map(function(e){return '<option value="'+e.id+'">'+e.nome+'</option>';}).join('')+'</select></div>';
      html+= '<div class="ed-field"><label>Tamanho fonte</label><input data-estilo="tamanho" type="number" value="'+(st.tamanho||40)+'"></div>';
      html+= '<div class="ed-field"><label>Tamanho mínimo</label><input data-estilo="tamanhoMin" type="number" value="'+(st.tamanhoMin||24)+'"></div>';
      html+= '<div class="ed-field"><label>Peso</label><input data-estilo="peso" type="number" value="'+(st.peso||700)+'"></div>';
      html+= '<div class="ed-field"><label>Alinhamento</label><select data-estilo="alinhamento"><option value="left" '+(st.alinhamento==='left'||!st.alinhamento?'selected':'')+'>Esquerda</option><option value="center" '+(st.alinhamento==='center'?'selected':'')+'>Centro</option><option value="right" '+(st.alinhamento==='right'?'selected':'')+'>Direita</option></select></div>';
      html+= corField('Cor','cor',el.cor||st.cor||'text');
      html+= '<div class="ed-field"><label>Limite de linhas</label><input data-estilo="limiteLinhas" type="number" value="'+(st.limiteLinhas||'')+'"></div>';
      html+= '<div class="ed-field"><label>Se exceder</label><select data-estilo="overflow"><option value="diminuir" '+(st.overflow==='diminuir'?'selected':'')+'>Reduzir fonte</option><option value="avisar" '+(st.overflow==='avisar'||!st.overflow?'selected':'')+'>Avisar</option><option value="cortar" '+(st.overflow==='cortar'?'selected':'')+'>Cortar</option></select></div>';
    }
    html+= '<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-gray-100">'
      + '<button type="button" class="c-btn c-btn-secondary c-btn-sm" data-camada="up" title="Trazer para frente">↑</button>'
      + '<button type="button" class="c-btn c-btn-secondary c-btn-sm" data-camada="down" title="Enviar para trás">↓</button>'
      + '<button type="button" class="c-btn c-btn-secondary c-btn-sm" data-copy-el title="Copiar (Ctrl+C)">Copiar</button>'
      + '<button type="button" class="c-btn c-btn-secondary c-btn-sm" data-dup-el title="Duplicar (Ctrl+D)">Duplicar</button>'
      + '<button type="button" class="c-btn c-btn-danger c-btn-sm ml-auto" data-del-el title="Excluir (Delete)">Excluir</button></div>';
    propsEl.innerHTML = html;
  }
  function renderCampos(){
    camposEl.innerHTML = state.campos.map(function(c,i){
      return '<div class="border border-gray-100 rounded-lg p-2 space-y-1">'
        + '<div class="flex gap-1"><input data-campo="chave" data-i="'+i+'" value="'+(c.chave||'')+'" placeholder="chave" style="flex:1;padding:4px 8px;border:1px solid #cbd5e1;border-radius:6px;font-size:12px">'
        + '<button type="button" data-del-campo="'+i+'" class="text-red-500 text-xs px-1">✕</button></div>'
        + '<input data-campo="rotulo" data-i="'+i+'" value="'+(c.rotulo||'')+'" placeholder="rótulo" style="width:100%;padding:4px 8px;border:1px solid #cbd5e1;border-radius:6px;font-size:12px">'
        + '<div class="flex gap-1 items-center text-[11px] text-gray-500"><select data-campo="tipo" data-i="'+i+'" style="flex:1;padding:3px;border:1px solid #cbd5e1;border-radius:6px">'+['texto','textarea','data','hora','url','numero'].map(function(t){return '<option value="'+t+'" '+(c.tipo===t?'selected':'')+'>'+t+'</option>';}).join('')+'</select>'
        + '<label class="flex items-center gap-1"><input type="checkbox" data-campo="obrigatorio" data-i="'+i+'" '+(c.obrigatorio?'checked':'')+'> obrig.</label>'
        + '<label class="flex items-center gap-1"><input type="checkbox" data-campo="fatoSensivel" data-i="'+i+'" '+(c.fatoSensivel?'checked':'')+'> sensível</label></div></div>';
    }).join('') || '<p class="text-[11px] text-gray-400">Nenhum campo.</p>';
  }
  function renderAll(){ renderTabs(); renderCanvas(); renderProps(); renderCampos(); renderLayers(); }

  // ── Eventos ───────────────────────────────────────────────────────────────
  document.getElementById('btn-add-var').addEventListener('click', function(){
    var chave = prompt('Formato da variante (ex.: 9:16, 3:4, capa, interna, final):', '3:4');
    if(!chave) return;
    var dims = { '9:16':[1080,1920], '3:4':[1080,1440], 'capa':[1080,1440], 'interna':[1080,1440], 'final':[1080,1440] }[chave] || [1080,1440];
    var papel = chave==='capa'?'capa':chave==='interna'?'interna':chave==='final'?'final':'principal';
    state.variantes.push({ chave:chave, papel:papel, nome:chave, largura:dims[0], altura:dims[1], elementos:[] });
    state.atual = state.variantes.length-1; state.sel=null; pushHistory(); renderAll();
  });
  document.getElementById('btn-del-var').addEventListener('click', function(){
    if(state.variantes.length<=1) return alert('É necessário ao menos uma variante.');
    if(!confirm('Remover a variante atual?')) return;
    state.variantes.splice(state.atual,1); state.atual=0; state.sel=null; pushHistory(); renderAll();
  });
  tabsEl.addEventListener('click', function(e){ var t=e.target.closest('[data-var]'); if(!t) return; state.atual=+t.dataset.var; state.sel=null; renderAll(); });

  document.querySelectorAll('[data-add]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var tipo=btn.dataset.add; var v=varAtual(); var camada=proxCamada(); var el;
      var cx=Math.round(v.largura/2), cy=Math.round(v.altura/2);
      if(tipo==='retangulo') el={id:uid(),tipo:'retangulo',x:Math.round(v.largura*0.1),y:Math.round(v.altura*0.1),w:Math.round(v.largura*0.5),h:160,fill:'primary',raio:0,camada:camada,opacidade:1};
      else if(tipo==='circulo') el={id:uid(),tipo:'circulo',cx:cx,cy:cy,r:150,fill:'accent',camada:camada};
      else if(tipo==='linha') el={id:uid(),tipo:'linha',x1:80,y1:cy,x2:v.largura-80,y2:cy,cor:'accent',espessura:12,camada:camada};
      else if(tipo==='imagem') el={id:uid(),tipo:'imagem',x:Math.round(v.largura*0.1),y:Math.round(v.altura*0.1),w:Math.round(v.largura*0.8),h:Math.round(v.largura*0.8),ajuste:'cover',raio:0,camada:camada,opacidade:1,editavel:true};
      else el={id:uid(),tipo:'texto',x:Math.round(v.largura*0.08),y:cy,w:Math.round(v.largura*0.84),valor:'{{titulo}}',variavel:state.campos[0]?state.campos[0].chave:'',camada:camada,estilo:{familia:'Arial, Helvetica, sans-serif',tamanho:64,tamanhoMin:28,peso:700,alturaLinha:1.15,alinhamento:'left',cor:'text',overflow:'avisar'}};
      v.elementos.push(el); state.sel=el.id; pushHistory(); renderCanvas(); renderProps(); renderLayers();
    });
  });

  // drag / resize
  var drag=null;
  inner.addEventListener('pointerdown', function(e){
    var handle=e.target.closest('.ed-handle'); var elDiv=e.target.closest('.ed-el'); if(!elDiv) { state.sel=null; renderCanvas(); renderProps(); return; }
    var id=elDiv.dataset.id; state.sel=id; renderCanvas(); renderProps();
    var v=varAtual(); var el=v.elementos.find(function(x){return x.id===id;}); var s=escala();
    drag={ id:id, handle:handle?handle.dataset.handle:null, sx:e.clientX, sy:e.clientY, el:JSON.parse(JSON.stringify(el)), scale:s };
    e.preventDefault();
  });
  window.addEventListener('pointermove', function(e){
    if(!drag) return; var dx=(e.clientX-drag.sx)/drag.scale, dy=(e.clientY-drag.sy)/drag.scale;
    var v=varAtual(); var el=v.elementos.find(function(x){return x.id===drag.id;}); if(!el) return; var o=drag.el;
    function set(o1){ Object.keys(o1).forEach(function(k){ el[k]=Math.round(o1[k]); }); }
    if(!drag.handle){ // move (+ snapping)
      if(el.tipo==='circulo') { el.cx=Math.round(o.cx+dx); el.cy=Math.round(o.cy+dy); limparGuias(); }
      else if(el.tipo==='linha') { el.x1=Math.round(o.x1+dx); el.y1=Math.round(o.y1+dy); el.x2=Math.round(o.x2+dx); el.y2=Math.round(o.y2+dy); limparGuias(); }
      else {
        var w=o.w||0, h=o.h||0;
        var tol=10/drag.scale;
        var sx=snapEixo(o.x+dx, w, v.largura, tol);
        var sy=snapEixo(o.y+dy, h, v.altura, tol);
        el.x=Math.round(sx.novaEsq); el.y=Math.round(sy.novaEsq);
        var guias=[]; if(sx.guia!==null) guias.push({axis:'v',pos:sx.guia}); if(sy.guia!==null) guias.push({axis:'h',pos:sy.guia});
        aplicarGuias(guias);
      }
    } else {
      var h=drag.handle;
      limparGuias();
      if(el.tipo==='retangulo'||el.tipo==='imagem'){
        var x=o.x,y=o.y,w=o.w,hh=o.h;
        if(h.indexOf('e')>=0) w=o.w+dx; if(h.indexOf('s')>=0) hh=o.h+dy;
        if(h.indexOf('w')>=0){ x=o.x+dx; w=o.w-dx; } if(h.indexOf('n')>=0){ y=o.y+dy; hh=o.h-dy; }
        set({x:x,y:y,w:Math.max(20,w),h:Math.max(20,hh)});
      } else if(el.tipo==='circulo'){
        var dep=(h==='se'||h==='e'||h==='s')?1:-1; set({r:Math.max(20,o.r+dep*(Math.abs(dx)>Math.abs(dy)?dx:dy))});
      } else if(el.tipo==='texto'){
        var x2=o.x, w2=o.w; if(h.indexOf('e')>=0) w2=o.w+dx; if(h.indexOf('w')>=0){ x2=o.x+dx; w2=o.w-dx; } set({x:x2,w:Math.max(40,w2)});
      } else if(el.tipo==='linha'){ if(h.indexOf('e')>=0) set({x2:o.x2+dx,y2:o.y2+dy}); }
    }
    renderCanvas(); renderProps();
  });
  window.addEventListener('pointerup', function(){
    if(drag){ drag=null; limparGuias(); pushHistory(); renderLayers(); }
  });

  // props edits
  propsEl.addEventListener('input', function(e){
    var el=varAtual().elementos.find(function(x){return x.id===state.sel;}); if(!el) return;
    var t=e.target;
    if(t.dataset.prop){ var k=t.dataset.prop; var val=t.value; if(['ajuste','valor','url','variavel','fill','cor'].indexOf(k)>=0) el[k]=val; else { var n=parseFloat(val); if(!isNaN(n)) el[k]=n; } }
    else if(t.dataset.estilo){ el.estilo=el.estilo||{}; var ek=t.dataset.estilo; var ev=parseFloat(t.value); el.estilo[ek]=isNaN(ev)?t.value:ev; if(ek==='limiteLinhas'&&!t.value) el.estilo.limiteLinhas=null; }
    else if(t.dataset.propCor){ el[t.dataset.propCor]=t.value; }
    renderCanvas();
  });
  // Aplicar cor a todos os elementos com a mesma cor (estilo "Canva")
  function corDe(el, key){ if (key === 'fill') return el.fill; if (key === 'cor') return el.cor; return null; }
  function definirCor(el, key, val){ if (key === 'fill') el.fill = val; else if (key === 'cor') el.cor = val; }

  propsEl.addEventListener('change', function(e){
    var el=varAtual().elementos.find(function(x){return x.id===state.sel;}); if(!el) return;
    var t = e.target;
    var corKey = null, corOld = null;
    if (t.dataset.prop === 'fill' || t.dataset.prop === 'cor') { corKey = t.dataset.prop; corOld = t.dataset.corOld; }
    else if (t.dataset.propCor) { corKey = t.dataset.propCor; corOld = t.dataset.corOld || null; }

    if(t.dataset.prop==='url') el.url=t.value;
    if(t.dataset.propCor){ el[t.dataset.propCor]=t.value; }
    if(t.id==='ed-aplicar-estilo'){ var id=+t.value; var s=SVG_ESTILOS.find(function(x){return x.id===id;}); if(s){ el.estilo={familia:s.familia,peso:s.peso,tamanho:s.tamanho,tamanhoMin:s.tamanho_min,alturaLinha:s.altura_linha,espacamentoLetras:s.espacamento_letras,alinhamento:s.alinhamento,cor:s.cor,limiteLinhas:s.limite_linhas,margem:s.margem,overflow:s.overflow}; } }

    if (corKey && corOld != null && corOld !== '') {
      var novo = corDe(el, corKey);
      if (novo != null && novo !== corOld) {
        var v = varAtual();
        var outros = v.elementos.filter(function(x){ return x.id !== el.id && corDe(x, corKey) === corOld; });
        if (outros.length > 0 && confirm('Aplicar a nova cor a todos os ' + outros.length + ' elemento(s) com a mesma cor?')) {
          outros.forEach(function(x){ definirCor(x, corKey, novo); });
        }
      }
    }
    pushHistory();
    renderProps();
    renderCanvas();
  });
  propsEl.addEventListener('click', function(e){
    if(e.target.dataset.copyEl!==undefined){ copiarSelecionado(); return; }
    if(e.target.dataset.dupEl!==undefined){ duplicarSelecionado(); return; }
    if(e.target.dataset.delEl!==undefined){ excluirSelecionado(); return; }
    if(e.target.dataset.camada){ var v2=varAtual(); var el=v2.elementos.find(function(x){return x.id===state.sel;}); if(el){ el.camada += (e.target.dataset.camada==='up'?1:-1); pushHistory(); renderCanvas(); renderLayers(); } }
  });

  // campos
  document.getElementById('btn-add-campo').addEventListener('click', function(){ state.campos.push({chave:'campo'+ (state.campos.length+1), rotulo:'Campo '+ (state.campos.length+1), tipo:'texto', obrigatorio:false}); pushHistory(); renderCampos(); });
  camposEl.addEventListener('input', function(e){ var i=e.target.dataset.i; if(i===undefined) return; var c=state.campos[+i]; if(!c) return; var k=e.target.dataset.campo; c[k]= e.target.type==='checkbox'?e.target.checked:e.target.value; if(k==='chave') renderProps(); });
  camposEl.addEventListener('click', function(e){ if(e.target.dataset.delCampo!==undefined){ state.campos.splice(+e.target.dataset.delCampo,1); pushHistory(); renderCampos(); } });

  // salvar
  function salvar(){
    document.getElementById('variantes_json').value = JSON.stringify(state.variantes);
    document.getElementById('campos_json').value = JSON.stringify(state.campos);
    document.getElementById('form-modelo').submit();
  }
  document.getElementById('btn-salvar').addEventListener('click', salvar);
  document.getElementById('form-modelo').addEventListener('submit', function(){ document.getElementById('variantes_json').value=JSON.stringify(state.variantes); document.getElementById('campos_json').value=JSON.stringify(state.campos); });

  window.addEventListener('resize', renderCanvas);

  fetch('/artes/ativos.json', { headers: { 'Accept':'application/json' } }).then(function(r){return r.json();}).then(function(d){ ATIVOS=d||[]; }).catch(function(){});

  renderAll();
  pushHistory();
})();
</script>
