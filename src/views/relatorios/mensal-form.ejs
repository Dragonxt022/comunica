<div class="max-w-4xl mx-auto px-4 py-8" x-data="mensalRelatorioForm()">
    <div class="flex items-center gap-3 mb-6">
        <a href="/relatorios" class="text-gray-500 hover:text-gray-700 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </a>
        <div>
            <h1 class="text-xl font-bold text-gray-900">Relatório Mensal</h1>
            <p class="text-sm text-gray-500 mt-0.5">Modelo com fundo, tipografia e organização fixos — datas, contrato e conteúdo do mês são preenchidos manualmente.</p>
        </div>
    </div>

    <form action="/relatorios/mensal/gerar" method="POST" enctype="multipart/form-data" target="_blank" class="space-y-5">

        <!-- Identificação -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <h2 class="font-semibold text-gray-800">Identificação</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Nº do relatório</label>
                    <input type="text" name="numero" required placeholder="Ex: 03" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Ano</label>
                    <input type="text" name="ano" required value="<%= new Date().getFullYear() %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Contrato Nº</label>
                    <input type="text" name="contrato" required placeholder="Ex: 059/2025" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Contratante</label>
                    <input type="text" name="contratante" required value="Prefeitura Municipal de <%= municipioNome %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Período de referência — início</label>
                    <input type="date" name="periodo_inicio" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Período de referência — fim</label>
                    <input type="date" name="periodo_fim" required value="<%= hojeISO %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
        </div>

        <!-- Textos fixos (editáveis) -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <h2 class="font-semibold text-gray-800">Textos do relatório <span class="text-xs font-normal text-gray-400">(pré-preenchidos, edite se precisar)</span></h2>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">1. Objeto do contrato</label>
                <textarea name="objeto_contrato" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= objetoContratoPadrao %></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">2. Objetivo do serviço</label>
                <textarea name="objetivo_servico" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= objetivoServicoPadrao %></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">3.1. Disponibilização de arquivos em nuvem</label>
                <textarea name="arquivos_nuvem" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= arquivosNuvemPadrao %></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">3.2. Foco editorial do período <span class="text-gray-400">(muda todo mês)</span></label>
                <textarea name="foco_editorial" rows="2" placeholder="Ex: Neste período a equipe atuou conforme demanda das pastas..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
        </div>

        <!-- 3.3 Reels -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="font-semibold text-gray-800">3.3. Vídeos / Reels</h2>
                <span class="text-xs text-gray-400" x-text="reels.length + ' item(ns)'"></span>
            </div>
            <template x-for="(item, idx) in reels" :key="item.id">
                <div class="border border-gray-200 rounded-lg p-3 bg-gray-50 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-gray-500">Reel <span x-text="idx + 1"></span></span>
                        <button type="button" @click="reels.splice(idx, 1)" class="text-red-400 hover:text-red-600 transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                    <input type="text" :name="'reel_titulo_' + idx" placeholder="Título" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="url" :name="'reel_link_' + idx" placeholder="Link (Instagram...)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <label class="block text-xs text-gray-500">Print/capa <span class="text-gray-400">(opcional)</span></label>
                    <input type="file" :name="'reel_imagem_' + idx" accept="image/*" class="w-full text-sm">
                </div>
            </template>
            <button type="button" @click="reels.push({ id: 'reel_' + Date.now() + '_' + (_counter++) })"
                class="w-full py-2 border-2 border-dashed border-blue-300 text-blue-600 text-sm font-medium rounded-lg hover:bg-blue-50 hover:border-blue-400 transition">
                + Adicionar reel
            </button>
        </div>

        <!-- 3.4 Artes gráficas -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <h2 class="font-semibold text-gray-800">3.4. Artes gráficas</h2>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Quantidade produzida no período</label>
                <input type="number" name="artes_count" min="0" placeholder="Ex: 27" class="w-full sm:w-40 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Imagens da grade <span class="text-gray-400">(opcional, pode selecionar várias)</span></label>
                <input type="file" name="artes_imagens" accept="image/*" multiple class="w-full text-sm">
            </div>
        </div>

        <!-- 3.5 Releases -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="font-semibold text-gray-800">3.5. Releases</h2>
                <span class="text-xs text-gray-400" x-text="releases.length + ' item(ns)'"></span>
            </div>
            <template x-for="(item, idx) in releases" :key="item.id">
                <div class="border border-gray-200 rounded-lg p-3 bg-gray-50 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-gray-500">Release <span x-text="idx + 1"></span></span>
                        <button type="button" @click="releases.splice(idx, 1)" class="text-red-400 hover:text-red-600 transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                    <input type="text" :name="'release_titulo_' + idx" placeholder="Título" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="url" :name="'release_link_' + idx" placeholder="Link" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <label class="block text-xs text-gray-500">Print <span class="text-gray-400">(opcional)</span></label>
                    <input type="file" :name="'release_imagem_' + idx" accept="image/*" class="w-full text-sm">
                </div>
            </template>
            <button type="button" @click="releases.push({ id: 'rel_' + Date.now() + '_' + (_counter++) })"
                class="w-full py-2 border-2 border-dashed border-blue-300 text-blue-600 text-sm font-medium rounded-lg hover:bg-blue-50 hover:border-blue-400 transition">
                + Adicionar release
            </button>
        </div>

        <!-- Textos finais -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">4. Resultados e evidências <span class="text-gray-400">(uma linha por item)</span></label>
                <textarea name="resultados_evidencias" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= resultadosEvidenciasPadrao %></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">5. Próximas etapas</label>
                <textarea name="proximas_etapas" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"><%= proximasEtapasPadrao %></textarea>
            </div>
        </div>

        <!-- Assinatura -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <h2 class="font-semibold text-gray-800">Assinatura</h2>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Cidade</label>
                    <input type="text" name="cidade_assinatura" value="<%= municipioNome %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Data</label>
                    <input type="date" name="data_assinatura" value="<%= hojeISO %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a href="/relatorios" class="px-4 py-2.5 border border-gray-300 text-gray-600 rounded-lg font-medium hover:bg-gray-50 transition text-sm">Cancelar</a>
            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition text-sm">Gerar relatório</button>
        </div>
    </form>
</div>

<script>
function mensalRelatorioForm() {
    return {
        reels: [],
        releases: [],
        _counter: 0,
    };
}
</script>
