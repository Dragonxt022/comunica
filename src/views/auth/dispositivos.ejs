<div class="max-w-3xl mx-auto space-y-6" x-data="dispositivosPage()">
    <div>
        <h2 class="text-xl font-semibold text-gray-900">Dispositivos conectados</h2>
        <p class="text-sm text-gray-400 mt-0.5">Veja onde sua conta está logada e encerre sessões que você não reconhece.</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
        <% dispositivos.forEach(function(d) { %>
        <div class="p-5 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0
                    <%= d.atual ? 'bg-emerald-50 text-emerald-600' : 'bg-gray-100 text-gray-400' %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m-6 0H7a2 2 0 01-2-2v-3a2 2 0 012-2h1m8 7h2a2 2 0 002-2v-3a2 2 0 00-2-2h-1"/>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-semibold text-gray-800 truncate"><%= d.label %></p>
                        <% if (d.atual) { %>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700 uppercase tracking-wide shrink-0">Este dispositivo</span>
                        <% } %>
                    </div>
                    <p class="text-xs text-gray-400 mt-0.5">
                        <% if (d.ip) { %>IP <%= d.ip %><% } %>
                        <% if (d.criadoEm) { %>
                        <%= d.ip ? ' · ' : '' %>Conectado em <%= new Date(d.criadoEm).toLocaleString('pt-BR') %>
                        <% } %>
                    </p>
                </div>
            </div>

            <% if (!d.atual) { %>
            <button type="button" @click="abrirModal('<%= d.sid %>', '<%= d.label.replace(/'/g, "\\'") %>')"
                class="shrink-0 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition">
                Encerrar
            </button>
            <% } %>
        </div>
        <% }); %>
    </div>

    <!-- Modal de confirmação -->
    <div x-show="modalAberto" x-cloak
         class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4"
         @keydown.escape.window="fecharModal()">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-sm p-6 space-y-4" @click.outside="fecharModal()">
            <div>
                <h3 class="text-base font-bold text-gray-900">Encerrar sessão</h3>
                <p class="text-sm text-gray-500 mt-1">
                    Confirme sua senha para desconectar <span class="font-semibold" x-text="alvoLabel"></span>.
                </p>
            </div>
            <input type="password" x-model="senha" @keydown.enter="confirmar()" placeholder="Sua senha atual" autofocus
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition text-sm">
            <p x-show="erro" x-text="erro" class="text-xs text-red-600"></p>
            <div class="flex justify-end gap-2 pt-1">
                <button type="button" @click="fecharModal()" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-600 text-sm font-medium hover:bg-gray-50 transition">
                    Cancelar
                </button>
                <button type="button" @click="confirmar()" :disabled="enviando"
                    class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-semibold hover:bg-red-700 disabled:opacity-50 transition">
                    <span x-show="!enviando">Encerrar sessão</span>
                    <span x-show="enviando">Encerrando...</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function dispositivosPage() {
    return {
        modalAberto: false,
        enviando: false,
        senha: '',
        erro: '',
        alvoSid: null,
        alvoLabel: '',

        abrirModal(sid, label) {
            this.alvoSid = sid;
            this.alvoLabel = label;
            this.senha = '';
            this.erro = '';
            this.modalAberto = true;
        },
        fecharModal() {
            this.modalAberto = false;
        },
        async confirmar() {
            if (!this.senha) {
                this.erro = 'Informe sua senha.';
                return;
            }
            this.enviando = true;
            this.erro = '';
            try {
                var r = await fetch('/dispositivos/' + this.alvoSid + '/encerrar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ senha: this.senha }),
                });
                var data = await r.json();
                if (data.ok) {
                    window.location.reload();
                } else {
                    this.erro = data.error || 'Não foi possível encerrar a sessão.';
                }
            } catch (e) {
                this.erro = 'Erro de conexão.';
            } finally {
                this.enviando = false;
            }
        },
    };
}
</script>
