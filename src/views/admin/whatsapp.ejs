<script>
var _WHATSAPP_STATUS = <%- JSON.stringify(status) %>;
</script>
<div class="space-y-6" x-data="whatsappAdminPage()">
    <div>
        <h2 class="text-2xl font-bold text-gray-900">WhatsApp</h2>
        <p class="text-gray-500">Conecte o número central da prefeitura para enviar notificações e responder ao comando "hoje".</p>
    </div>

    <!-- Status da conexão -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
        <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            Status da conexão
        </h3>
        <div class="flex items-center gap-2">
            <span x-show="conectado" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-green-100 text-green-700">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                Conectado
            </span>
            <span x-show="!conectado && reconectando" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-100 text-amber-700">
                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                Reconectando…
            </span>
            <span x-show="!conectado && !reconectando" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-gray-100 text-gray-600">
                <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                Desconectado
            </span>
            <span x-show="conectado && numero" class="text-sm text-gray-500" x-text="'como +' + numero"></span>
        </div>
    </div>

    <!-- Parear novo dispositivo -->
    <div x-show="!conectado" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
        <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
            Parear novo dispositivo
        </h3>
        <ol class="text-sm text-gray-600 list-decimal list-inside space-y-1">
            <li>Abra o WhatsApp no celular da prefeitura</li>
            <li>Toque em Configurações &gt; Aparelhos conectados</li>
            <li>Toque em "Conectar um aparelho" e escaneie o código abaixo</li>
        </ol>

        <div class="flex flex-col items-center gap-3 py-4">
            <template x-if="qr">
                <img :src="qr" alt="QR Code do WhatsApp" class="w-56 h-56 rounded-lg border border-gray-200">
            </template>
            <template x-if="!qr">
                <div class="w-56 h-56 rounded-lg border border-dashed border-gray-300 flex items-center justify-center text-sm text-gray-400 text-center px-4">
                    <span x-text="conectando ? 'Gerando QR code…' : 'Clique em Conectar para gerar o QR code'"></span>
                </div>
            </template>
        </div>

        <form action="/admin/whatsapp/conectar" method="POST">
            <button type="submit" :disabled="conectando"
                class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition shadow-sm disabled:opacity-50 disabled:cursor-wait">
                <span x-text="conectando ? 'Conectando…' : 'Conectar'"></span>
            </button>
        </form>
    </div>

    <!-- Desconectar -->
    <div x-show="conectado" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-4">
        <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.36 6.64a9 9 0 11-12.73 0M12 3v9"></path></svg>
            Desconectar
        </h3>
        <p class="text-sm text-gray-500">Isso desvincula o número atual — será necessário escanear um novo QR code para reconectar.</p>
        <form action="/admin/whatsapp/desconectar" method="POST" onsubmit="return confirm('Desconectar o WhatsApp da prefeitura? Será necessário parear novamente.');">
            <button type="submit" class="px-5 py-2.5 border border-red-300 text-red-600 rounded-lg font-medium hover:bg-red-50 transition">
                Desconectar
            </button>
        </form>
    </div>
</div>

<script>
function whatsappAdminPage() {
    var initialStatus = _WHATSAPP_STATUS;
    return {
        conectado: initialStatus.conectado,
        conectando: initialStatus.conectando,
        reconectando: false,
        qr: initialStatus.qr,
        numero: initialStatus.numero,
        init() {
            var es = new EventSource('/sse');
            var self = this;
            es.addEventListener('whatsapp:qr', function(e) {
                var data = JSON.parse(e.data);
                self.qr = data.qr;
                self.conectando = true;
            });
            es.addEventListener('whatsapp:status', function(e) {
                var data = JSON.parse(e.data);
                self.conectado = data.conectado;
                self.numero = data.numero;
                self.reconectando = !!data.reconectando;
                if (data.conectado) { self.qr = null; self.conectando = false; }
            });
        }
    };
}
</script>
