<div class="space-y-6">

    <!-- Cabeçalho -->
    <div class="flex items-center gap-3">
        <a href="/admin/municipios" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </a>
        <div>
            <h2 class="text-2xl font-bold text-slate-900"><%= municipio ? 'Editar Município' : 'Novo Município' %></h2>
            <p class="text-sm text-slate-500"><%= municipio ? 'Atualize os dados do município.' : 'Preencha os dados para cadastrar um novo município.' %></p>
        </div>
    </div>

    <% if(errors && errors.length > 0) { %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700 flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div><% errors.forEach(e => { %><p><%= e %></p><% }) %></div>
        </div>
    <% } %>

    <form action="<%= municipio ? '/admin/municipios/' + municipio.id : '/admin/municipios' %>" method="POST" enctype="multipart/form-data" class="space-y-5">

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Dados do Município</h3>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Nome <span class="text-red-500">*</span></label>
                <input type="text" name="nome" required
                    value="<%= municipio ? municipio.nome : '' %>"
                    placeholder="Ex: Cujubim"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Estado (UF) <span class="text-red-500">*</span></label>
                <select name="estado" required
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm">
                    <% const ufs = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']; %>
                    <% ufs.forEach(uf => { %>
                    <option value="<%= uf %>" <%= municipio && municipio.estado === uf ? 'selected' : (uf === 'RO' && !municipio ? 'selected' : '') %>><%= uf %></option>
                    <% }) %>
                </select>
            </div>

            <% if (municipio) { %>
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div>
                    <p class="text-sm font-medium text-slate-700">Município ativo</p>
                    <p class="text-xs text-slate-400 mt-0.5">Municípios inativos não aparecem nas seleções</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="ativo" class="sr-only peer" <%= municipio.ativo ? 'checked' : '' %>>
                    <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:bg-blue-600
                        after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                        after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all
                        peer-checked:after:translate-x-full relative"></div>
                </label>
            </div>
            <% } %>
        </div>

        <!-- Identidade institucional (documentos / PDF) -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
            <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Identidade institucional (documentos / PDF)</h3>
            <p class="text-xs text-slate-500 -mt-2">Usada no cabeçalho centralizado das exportações em PDF (planejamentos, relatórios, etc.).</p>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Logo / Brasão</label>
                <div class="flex items-center gap-4">
                    <div class="w-20 h-20 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center overflow-hidden shrink-0">
                        <% if (municipio && municipio.logo) { %>
                            <img src="<%= municipio.logo %>" alt="Logo" class="max-w-full max-h-full object-contain">
                        <% } else { %>
                            <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <% } %>
                    </div>
                    <div class="flex-1 space-y-2">
                        <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif"
                            class="block w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition">
                        <p class="text-xs text-slate-400">PNG com fundo transparente fica melhor. Máx. 5 MB.</p>
                        <% if (municipio && municipio.logo) { %>
                        <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                            <input type="checkbox" name="remover_logo" value="1" class="w-4 h-4 rounded border-slate-300 text-red-600 focus:ring-red-500">
                            Remover logo atual
                        </label>
                        <% } %>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Linha do cabeçalho</label>
                <input type="text" name="cabecalho"
                    value="<%= municipio && municipio.cabecalho ? municipio.cabecalho : '' %>"
                    placeholder="Ex: Prefeitura Municipal de Cujubim"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                <p class="text-xs text-slate-400 mt-1">Se ficar vazio, usa "Prefeitura Municipal de &lt;nome&gt;".</p>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Rodapé do documento</label>
                <input type="text" name="rodape"
                    value="<%= municipio && municipio.rodape ? municipio.rodape : '' %>"
                    placeholder="Ex: Av. Principal, 100 — Centro · (69) 99999-9999"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
            </div>
        </div>

        <!-- Ações -->
        <div class="flex justify-end gap-3">
            <a href="/admin/municipios"
                class="px-5 py-2.5 border border-slate-300 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition font-medium">
                Cancelar
            </a>
            <button type="submit"
                class="px-6 py-2.5 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition font-semibold shadow-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <%= municipio ? 'Salvar Alterações' : 'Criar Município' %>
            </button>
        </div>

    </form>
</div>
