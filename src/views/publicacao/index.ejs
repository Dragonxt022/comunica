<%
const mapItem = (s) => ({
  id: s.id,
  titulo: s.titulo || '',
  secretaria_nome: s.secretaria ? s.secretaria.nome : '',
  secretaria_cor: s.secretaria ? (s.secretaria.cor || '#6366f1') : '#6366f1',
  tipo_midia: s.tipo_midia || '',
  prioridade: s.prioridade || 'media',
  prazo: s.prazo || '',
  status: s.status || '',
  link_publicacao: s.link_publicacao || '',
  data_publicacao: s.data_publicacao ? new Date(s.data_publicacao).toISOString() : '',
  arte_final_url: s.arte_final_url || '',
});
const apublicarJson = JSON.stringify(aPublicar.map(mapItem)).replace(/</g, '\\u003c');
const publicadasJson = JSON.stringify(publicadas.map(mapItem)).replace(/</g, '\\u003c');
%>
<script id="pub-apublicar" type="application/json"><%- apublicarJson %></script>
<script id="pub-publicadas" type="application/json"><%- publicadasJson %></script>

<div class="max-w-5xl mx-auto space-y-5" x-data="pubPage()" x-init="init()">

    <!-- Cabeçalho -->
    <div class="flex items-start justify-between gap-3 flex-wrap">
        <div>
            <h2 class="text-2xl font-bold text-slate-900">Publicação</h2>
            <p class="text-sm text-slate-500 mt-0.5">O que falta publicar e o que já saiu.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-amber-50 border border-amber-200 text-sm font-semibold text-amber-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <%= totalAPublicar %> a publicar
            </span>
        </div>
    </div>

    <!-- Abas -->
    <div class="flex items-center gap-1 bg-slate-100 rounded-lg p-1 w-fit">
        <a href="?aba=a_publicar" class="px-4 py-1.5 text-sm rounded-md transition <%= abaAtiva === 'a_publicar' ? 'bg-white shadow text-indigo-700 font-semibold' : 'text-slate-500 hover:text-slate-700' %>">
            A publicar (<%= totalAPublicar %>)
        </a>
        <a href="?aba=publicadas" class="px-4 py-1.5 text-sm rounded-md transition <%= abaAtiva === 'publicadas' ? 'bg-white shadow text-indigo-700 font-semibold' : 'text-slate-500 hover:text-slate-700' %>">
            Publicadas (<%= totalPublicadas %>)
        </a>
    </div>

    <!-- Filtros -->
    <form method="GET" action="/publicacao" class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex flex-wrap items-center gap-2">
        <input type="hidden" name="aba" value="<%= abaAtiva %>">
        <input type="text" name="q" value="<%= filtros.q %>" placeholder="Buscar por título..."
            class="flex-1 min-w-[180px] px-3 py-2 rounded-lg border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        <select name="secretaria" class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-white outline-none">
            <option value="">Secretaria: todas</option>
            <% secretarias.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= filtros.secretaria == s.id ? 'selected' : '' %>><%= s.nome %></option>
            <% }); %>
        </select>
        <select name="tipo" class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-white outline-none">
            <option value="">Tipo: todos</option>
            <% ['Nota','Release','Post para Redes Sociais','Arte Gráfica','Vídeo','Foto','Outros'].forEach(function(t) { %>
            <option value="<%= t %>" <%= filtros.tipo === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
        </select>
        <% if (abaAtiva === 'a_publicar') { %>
        <label class="inline-flex items-center gap-2 px-3 py-2 text-sm text-slate-600 cursor-pointer">
            <input type="checkbox" name="atrasadas" value="1" <%= filtros.atrasadas ? 'checked' : '' %> class="w-4 h-4 rounded border-slate-300 text-indigo-600">
            Só atrasadas
        </label>
        <% } %>
        <button type="submit" class="px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-semibold hover:bg-slate-900 transition">Filtrar</button>
        <% if (filtros.q || filtros.secretaria || filtros.tipo || filtros.atrasadas) { %>
        <a href="?aba=<%= abaAtiva %>" class="px-3 py-2 text-sm text-slate-500 hover:text-slate-700">Limpar</a>
        <% } %>
    </form>

    <!-- Aba: A publicar -->
    <div x-show="aba === 'a_publicar'">
        <% if (podePublicar) { %>
        <form method="POST" action="/publicacao/publicar-todas" x-show="aPublicar.length > 0" x-cloak
              onsubmit="return confirm('Marcar TODAS as solicitações listadas abaixo como publicadas?\n\nUse isto para limpar o histórico antigo (de antes deste controle). Dá para desfazer item por item depois.')"
              class="mb-3 flex items-center justify-between gap-3 flex-wrap px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl">
            <input type="hidden" name="q" value="<%= filtros.q %>">
            <input type="hidden" name="secretaria" value="<%= filtros.secretaria %>">
            <input type="hidden" name="tipo" value="<%= filtros.tipo %>">
            <% if (filtros.atrasadas) { %><input type="hidden" name="atrasadas" value="1"><% } %>
            <span class="text-xs text-amber-800">
                Histórico antigo? Você pode marcar <b x-text="aPublicar.length"></b> item(ns) de uma vez
                <span x-show="<%= !!(filtros.q || filtros.secretaria || filtros.tipo || filtros.atrasadas) %>"> (respeitando os filtros aplicados)</span>.
            </span>
            <button type="submit" class="shrink-0 px-4 py-2 rounded-lg bg-amber-600 text-white text-sm font-semibold hover:bg-amber-700 transition">
                Marcar todas como publicadas
            </button>
        </form>
        <% } %>
        <div x-show="aPublicar.length === 0" class="text-center py-16 border-2 border-dashed border-slate-100 rounded-xl">
            <div class="text-4xl mb-3">🎉</div>
            <p class="text-sm text-slate-400">Nada pendente de publicação. Tudo em dia!</p>
        </div>
        <div class="space-y-2">
            <template x-for="s in aPublicar" :key="s.id">
                <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-start gap-3">
                    <span class="shrink-0 mt-1 w-2.5 h-2.5 rounded-full" :style="'background:' + s.secretaria_cor"></span>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-start gap-2 flex-wrap">
                            <a :href="'/solicitacoes/' + s.id" class="text-sm font-semibold text-slate-900 flex-1 hover:text-indigo-600 transition" x-text="s.titulo"></a>
                            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full" :class="priorClass(s.prioridade)" x-text="priorLabel(s.prioridade)"></span>
                        </div>
                        <div class="flex items-center gap-3 mt-1 flex-wrap text-xs text-slate-500">
                            <span x-show="s.secretaria_nome" x-text="s.secretaria_nome"></span>
                            <span x-show="s.tipo_midia">· <span x-text="s.tipo_midia"></span></span>
                            <span x-show="s.prazo" class="inline-flex items-center gap-1" :class="isVencida(s) ? 'text-red-500 font-semibold' : ''">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                <span x-text="(isVencida(s) ? 'Prazo vencido — ' : 'Prazo: ') + fmtDate(s.prazo)"></span>
                            </span>
                        </div>
                    </div>
                    <% if (podePublicar) { %>
                    <button type="button" @click="abrirPublicar(s)"
                        class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Publicar
                    </button>
                    <% } %>
                </div>
            </template>
        </div>
    </div>

    <!-- Aba: Publicadas -->
    <div x-show="aba === 'publicadas'">
        <div x-show="publicadas.length === 0" class="text-center py-16 border-2 border-dashed border-slate-100 rounded-xl">
            <div class="text-4xl mb-3">📭</div>
            <p class="text-sm text-slate-400">Nenhuma publicação registrada ainda.</p>
        </div>
        <div class="space-y-2">
            <template x-for="s in publicadas" :key="s.id">
                <div class="bg-white border border-slate-200 rounded-xl p-4 flex items-start gap-3">
                    <span class="shrink-0 mt-0.5 w-9 h-9 rounded-lg flex items-center justify-center bg-emerald-50 text-emerald-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    <div class="flex-1 min-w-0">
                        <a :href="'/solicitacoes/' + s.id" class="text-sm font-semibold text-slate-900 hover:text-indigo-600 transition" x-text="s.titulo"></a>
                        <div class="flex items-center gap-3 mt-1 flex-wrap text-xs text-slate-500">
                            <span x-show="s.secretaria_nome" x-text="s.secretaria_nome"></span>
                            <span x-show="s.tipo_midia">· <span x-text="s.tipo_midia"></span></span>
                            <span class="inline-flex items-center gap-1 text-emerald-600 font-medium">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                <span x-text="fmtDateTime(s.data_publicacao)"></span>
                            </span>
                            <template x-if="s.link_publicacao">
                                <a :href="s.link_publicacao" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-blue-600 hover:underline">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                    Ver publicação
                                </a>
                            </template>
                        </div>
                    </div>
                    <% if (podePublicar) { %>
                    <button type="button" @click="despublicar(s)"
                        class="shrink-0 px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-red-600 border border-slate-200 hover:border-red-200 rounded-lg transition">
                        Despublicar
                    </button>
                    <% } %>
                </div>
            </template>
        </div>
    </div>

    <!-- Modal: marcar como publicada -->
    <div x-show="modal" x-cloak style="display:none;background:rgba(15,23,42,0.6);backdrop-filter:blur(2px)"
        class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4" @click.outside="modal = false">
            <div>
                <h3 class="text-base font-bold text-slate-900">Marcar como publicada</h3>
                <p class="text-xs text-slate-400 mt-0.5" x-text="cur.titulo"></p>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Data de publicação</label>
                <input type="datetime-local" x-model="dataPub" class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Link da publicação <span class="text-slate-400 font-normal">(opcional)</span></label>
                <input type="url" x-model="linkPub" placeholder="https://..." class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none text-sm">
            </div>
            <div class="flex justify-end gap-2 pt-1">
                <button type="button" @click="modal = false" class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50 transition">Cancelar</button>
                <button type="button" @click="confirmar()" :disabled="salvando"
                    class="px-5 py-2 rounded-lg bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition disabled:opacity-60"
                    x-text="salvando ? 'Salvando…' : 'Confirmar publicação'"></button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div x-show="toast !== ''" x-transition class="fixed bottom-6 right-6 z-[60] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white"
        :class="toastOk ? 'bg-green-600' : 'bg-red-600'" x-text="toast"></div>
</div>

<script>
function pubPage() {
    return {
        aba: '<%= abaAtiva %>',
        aPublicar: [],
        publicadas: [],
        modal: false,
        cur: { id: null, titulo: '', link: '' },
        dataPub: '',
        linkPub: '',
        salvando: false,
        toast: '',
        toastOk: true,

        init: function () {
            try { this.aPublicar = JSON.parse(document.getElementById('pub-apublicar').textContent); } catch (e) { this.aPublicar = []; }
            try { this.publicadas = JSON.parse(document.getElementById('pub-publicadas').textContent); } catch (e) { this.publicadas = []; }
        },

        priorLabel: function (p) { return ({ alta: 'Alta', media: 'Média', baixa: 'Baixa' })[p] || p; },
        priorClass: function (p) { return ({ alta: 'bg-red-100 text-red-700', media: 'bg-amber-100 text-amber-700', baixa: 'bg-green-100 text-green-700' })[p] || 'bg-slate-100 text-slate-600'; },
        fmtDate: function (p) { return p ? new Date(p + 'T00:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }) : ''; },
        fmtDateTime: function (d) {
            if (!d) return '';
            return new Date(d).toLocaleString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        },
        isVencida: function (s) {
            if (!s.prazo) return false;
            var d = new Date(s.prazo + 'T00:00:00');
            var h = new Date(); h.setHours(0, 0, 0, 0);
            return d < h;
        },
        showToast: function (msg, ok) {
            var self = this;
            this.toast = msg; this.toastOk = ok;
            setTimeout(function () { self.toast = ''; }, 3500);
        },

        abrirPublicar: function (s) {
            this.cur = { id: s.id, titulo: s.titulo, link: s.link_publicacao };
            var now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            this.dataPub = now.toISOString().slice(0, 16);
            this.linkPub = s.link_publicacao || '';
            this.modal = true;
        },

        confirmar: async function () {
            if (!this.cur.id) return;
            this.salvando = true;
            try {
                var res = await fetch('/publicacao/' + this.cur.id + '/publicar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ data_publicacao: this.dataPub || null, link_publicacao: this.linkPub }),
                });
                var data = await res.json();
                if (!data.ok) throw new Error(data.error || 'Falha ao publicar.');
                window.location.reload();
            } catch (err) {
                this.showToast(err.message || 'Falha ao publicar.', false);
            } finally {
                this.salvando = false;
            }
        },

        despublicar: async function (s) {
            if (!confirm('Desfazer a publicação de "' + s.titulo + '"?')) return;
            try {
                var res = await fetch('/publicacao/' + s.id + '/despublicar', { method: 'POST' });
                var data = await res.json();
                if (!data.ok) throw new Error(data.error || 'Falha ao desfazer.');
                window.location.reload();
            } catch (err) {
                this.showToast(err.message || 'Falha ao desfazer.', false);
            }
        },
    };
}
</script>
