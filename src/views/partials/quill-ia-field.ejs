<%
/* =============================================================================
   Partial: campo de descrição rico (Quill) + assistente de IA.
   Parâmetros do include:
     editorId      -> id único do editor (opcional)
     inputName     -> nome do input hidden enviado no form (ex.: 'descricao')
     titleInputId  -> id do input de título (usado em "gerar a partir do título")
     placeholder   -> texto de placeholder do editor
     initialHtml   -> conteúdo inicial (telas de edição)
   ============================================================================= */
var __editorId  = typeof editorId  !== 'undefined' && editorId  ? editorId  : ('quill-ia-' + Math.random().toString(36).slice(2, 8));
var __inputName = typeof inputName !== 'undefined' && inputName ? inputName : 'descricao';
var __titleId   = typeof titleInputId !== 'undefined' ? titleInputId : '';
var __ph        = typeof placeholder  !== 'undefined' ? placeholder  : 'Descreva com detalhes: contexto, público-alvo, referências, informações importantes...';
var __initial   = typeof initialHtml  !== 'undefined' ? initialHtml  : '';
var __required  = typeof required     !== 'undefined' ? !!required    : false;
%>
<%- include('quill-styles.ejs') %>

<div class="quill-ia-field" data-quill-ia data-title-input="<%= __titleId %>" data-placeholder="<%= __ph %>" data-ia-required="<%= __required ? '1' : '0' %>" id="<%= __editorId %>-wrap">

    <!-- Ações de IA -->
    <div class="flex flex-wrap items-center gap-2 mb-2.5">
        <button type="button" data-ia="chat"
            title="Descreva em uma conversa e a IA organiza o texto pra você"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold rounded-lg bg-purple-600 text-white hover:bg-purple-700 transition shadow-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            Conversar com a IA
        </button>
        <button type="button" data-ia="sugerir"
            title="Gerar uma descrição automaticamente a partir do título"
            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-wait">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            <span data-label>Gerar a partir do título</span>
        </button>
        <button type="button" data-ia="corrigir"
            title="Corrigir ortografia e clareza do texto já escrito"
            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 transition disabled:opacity-50 disabled:cursor-wait">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span data-label>Corrigir texto</span>
        </button>
    </div>

    <!-- Editor -->
    <div data-ia-editor></div>
    <input type="hidden" name="<%= __inputName %>" data-ia-hidden>
    <p class="text-xs text-gray-400 mt-1">Sugestões de IA estão em fase de teste — revise sempre antes de enviar.</p>

    <!-- Conteúdo inicial (edição) em JSON, lido pelo script abaixo -->
    <script type="application/json" data-ia-initial><%- JSON.stringify(__initial || '') %></script>

    <!-- Modal: estruturação via chat -->
    <div data-ia-modal style="display:none;background:rgba(15,23,42,0.6);backdrop-filter:blur(2px)"
        class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full h-[80vh] max-h-[700px] flex flex-col">
            <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-gray-900">Estruturar com IA</h3>
                        <p class="text-xs text-gray-400">Descreva o que precisa — a IA organiza o texto</p>
                    </div>
                </div>
                <button type="button" data-ia-close class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4" data-ia-messages></div>
            <div class="border-t border-gray-100 p-3 space-y-2">
                <div class="flex items-end gap-1.5 rounded-2xl border border-gray-300 bg-white px-2 py-1.5 transition focus-within:border-purple-400 focus-within:ring-2 focus-within:ring-purple-100">
                    <textarea data-ia-input rows="1" placeholder="Descreva o que precisa..."
                        class="flex-1 px-2 py-1.5 outline-none text-sm resize-none bg-transparent max-h-32"></textarea>
                    <button type="button" data-ia-send
                        class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full bg-purple-600 text-white hover:bg-purple-700 transition disabled:bg-gray-100 disabled:text-gray-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0l-6 6m6-6l6 6"></path></svg>
                    </button>
                </div>
                <button type="button" data-ia-add disabled
                    class="w-full px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-semibold hover:bg-emerald-700 transition disabled:opacity-40 disabled:cursor-not-allowed inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Adicionar ao formulário
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div data-ia-toast style="display:none" class="fixed bottom-6 right-6 z-[60] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<script>
(function () {
    function boot() {
        document.querySelectorAll('[data-quill-ia]').forEach(function (el) {
            if (el.dataset.iaReady) return;
            el.dataset.iaReady = '1';
            try { init(el); } catch (e) { console.error('quill-ia init:', e); }
        });
    }

    function init(el) {
        var editorRoot = el.querySelector('[data-ia-editor]');
        var hidden     = el.querySelector('[data-ia-hidden]');
        var titleId    = el.getAttribute('data-title-input') || '';
        var ph         = el.getAttribute('data-placeholder') || '';
        var initial    = '';
        var initEl     = el.querySelector('[data-ia-initial]');
        if (initEl) { try { initial = JSON.parse(initEl.textContent || '""'); } catch (e) { initial = ''; } }

        var quill = new Quill(editorRoot, {
            theme: 'snow',
            placeholder: ph,
            modules: {
                toolbar: [
                    [{ header: [2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ align: [] }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['link'],
                    ['clean']
                ]
            }
        });
        if (initial) quill.root.innerHTML = initial;

        function setText(text) {
            if (document.activeElement && document.activeElement !== document.body) document.activeElement.blur();
            var sel = window.getSelection && window.getSelection();
            if (sel) sel.removeAllRanges();
            quill.setText(text || '');
        }
        function getTitle() {
            var t = titleId ? document.getElementById(titleId) : null;
            return t ? t.value.trim() : '';
        }

        var toastEl = el.querySelector('[data-ia-toast]');
        var toastTimer = null;
        function toast(msg, ok) {
            if (!toastEl) return;
            toastEl.textContent = msg;
            toastEl.className = 'fixed bottom-6 right-6 z-[60] px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white ' + (ok ? 'bg-green-600' : 'bg-red-600');
            toastEl.style.display = 'block';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { toastEl.style.display = 'none'; }, 3500);
        }

        function setLoading(btn, loading, idleLabel, loadingLabel) {
            btn.disabled = loading;
            var lbl = btn.querySelector('[data-label]');
            if (lbl) lbl.textContent = loading ? loadingLabel : idleLabel;
        }

        var btnSug = el.querySelector('[data-ia="sugerir"]');
        var btnCor = el.querySelector('[data-ia="corrigir"]');

        if (btnSug) btnSug.addEventListener('click', function () {
            var titulo = getTitle();
            if (!titulo) { toast('Preencha o título primeiro.', false); return; }
            setLoading(btnSug, true, 'Gerar a partir do título', 'Gerando…');
            fetch('/ia/sugerir-descricao', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo: titulo }) })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (res) {
                    if (res.ok) { setText(res.d.descricao); toast(res.d.usouFallback ? 'Sugestão gerada com modelo local — revise antes de enviar.' : 'Sugestão gerada — revise antes de enviar.', true); }
                    else { toast(res.d.error || 'Erro ao gerar sugestão.', false); }
                })
                .catch(function () { toast('Assistente de IA indisponível no momento.', false); })
                .finally(function () { setLoading(btnSug, false, 'Gerar a partir do título', 'Gerando…'); });
        });

        if (btnCor) btnCor.addEventListener('click', function () {
            var texto = quill.getText().trim();
            if (!texto) { toast('Escreva o texto antes de corrigir.', false); return; }
            setLoading(btnCor, true, 'Corrigir texto', 'Corrigindo…');
            fetch('/ia/corrigir-texto', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ texto: texto }) })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (res) {
                    if (res.ok) { setText(res.d.texto); toast(res.d.usouFallback ? 'Texto corrigido com modelo local — revise antes de enviar.' : 'Texto corrigido — revise antes de enviar.', true); }
                    else { toast(res.d.error || 'Erro ao corrigir texto.', false); }
                })
                .catch(function () { toast('Assistente de IA indisponível no momento.', false); })
                .finally(function () { setLoading(btnCor, false, 'Corrigir texto', 'Corrigindo…'); });
        });

        // ── Chat ──────────────────────────────────────────────────────────────
        var modal   = el.querySelector('[data-ia-modal]');
        var msgsBox = el.querySelector('[data-ia-messages]');
        var input   = el.querySelector('[data-ia-input]');
        var sendBtn = el.querySelector('[data-ia-send]');
        var addBtn  = el.querySelector('[data-ia-add]');
        var mensagens = [];

        function bubble(role, texto) {
            var wrap = document.createElement('div');
            if (role === 'user') {
                wrap.className = 'flex justify-end';
                var b = document.createElement('div');
                b.className = 'max-w-[80%] rounded-2xl rounded-br-md bg-purple-600 text-white px-4 py-2.5 text-sm leading-relaxed whitespace-pre-wrap';
                b.textContent = texto;
                wrap.appendChild(b);
            } else {
                wrap.className = 'flex gap-2.5 max-w-[92%]';
                var av = document.createElement('div');
                av.className = 'w-6 h-6 rounded-full bg-purple-100 flex items-center justify-center shrink-0 mt-0.5 text-purple-600 text-[11px] font-bold';
                av.textContent = 'IA';
                var t = document.createElement('div');
                t.className = 'text-sm text-gray-800 leading-relaxed whitespace-pre-wrap pt-0.5';
                t.textContent = texto;
                wrap.appendChild(av); wrap.appendChild(t);
            }
            msgsBox.appendChild(wrap);
        }
        function renderChat() {
            msgsBox.innerHTML = '';
            mensagens.forEach(function (m) { bubble(m.role, m.texto); });
            msgsBox.scrollTop = msgsBox.scrollHeight;
        }
        function openChat() {
            if (mensagens.length === 0) {
                mensagens.push({ role: 'assistant', texto: 'Me conte o que você precisa: contexto, público-alvo, informações importantes, prazo... Quanto mais detalhes, melhor o texto final.' });
                renderChat();
            }
            modal.style.display = 'flex';
            input.focus();
        }
        function closeChat() { modal.style.display = 'none'; }
        function hasAssistant() { return mensagens.some(function (m) { return m.role === 'assistant'; }); }

        var btnChat = el.querySelector('[data-ia="chat"]');
        if (btnChat) btnChat.addEventListener('click', openChat);
        el.querySelector('[data-ia-close]').addEventListener('click', closeChat);
        modal.addEventListener('click', function (ev) { if (ev.target === modal) closeChat(); });
        document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape' && modal.style.display === 'flex') closeChat(); });

        function enviar() {
            var texto = input.value.trim();
            if (!texto) return;
            mensagens.push({ role: 'user', texto: texto });
            input.value = '';
            input.style.height = 'auto';
            renderChat();
            sendBtn.disabled = true;
            fetch('/ia/estruturar-chamado', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo: getTitle(), mensagens: mensagens }) })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (res) {
                    if (res.ok) { mensagens.push({ role: 'assistant', texto: res.d.resposta }); if (res.d.usouFallback) toast('Resposta gerada com modelo local (nuvem indisponível).', true); }
                    else { mensagens.push({ role: 'assistant', texto: res.d.error || 'Erro ao consultar a IA.' }); }
                })
                .catch(function () { mensagens.push({ role: 'assistant', texto: 'Assistente de IA indisponível no momento.' }); })
                .finally(function () { sendBtn.disabled = false; renderChat(); addBtn.disabled = !hasAssistant(); });
        }
        sendBtn.addEventListener('click', enviar);
        input.addEventListener('keydown', function (ev) { if (ev.key === 'Enter' && !ev.shiftKey) { ev.preventDefault(); enviar(); } });
        input.addEventListener('input', function () { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 128) + 'px'; });

        addBtn.addEventListener('click', function () {
            var ultima = null;
            for (var i = mensagens.length - 1; i >= 0; i--) { if (mensagens[i].role === 'assistant') { ultima = mensagens[i]; break; } }
            if (!ultima) { toast('Converse com a IA antes de adicionar.', false); return; }
            setText(ultima.texto);
            closeChat();
            toast('Texto estruturado adicionado ao formulário — revise antes de enviar.', true);

            // Preenche o título automaticamente, se ainda estiver vazio
            var tEl = titleId ? document.getElementById(titleId) : null;
            if (tEl && !tEl.value.trim()) {
                fetch('/ia/sugerir-titulo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ texto: ultima.texto }) })
                    .then(function (r) { return r.json(); })
                    .then(function (d) { if (d && d.titulo) tEl.value = d.titulo; })
                    .catch(function () { /* título é opcional */ });
            }
        });

        // ── Submit: sincroniza o HTML do editor com o input hidden ────────────
        var isRequired = el.getAttribute('data-ia-required') === '1';
        var form = el.closest('form');
        if (form) form.addEventListener('submit', function (ev) {
            var html = quill.root.innerHTML;
            var vazio = (html === '<p><br></p>');
            if (hidden) hidden.value = vazio ? '' : html;
            if (isRequired && vazio) {
                ev.preventDefault();
                toast('Escreva a descrição antes de enviar.', false);
            }
        });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
</script>
