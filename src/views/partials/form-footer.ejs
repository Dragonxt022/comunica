<%
/* =============================================================================
   Partial: rodapé padrão de formulário (ajuda + cancelar + salvar).
   Parâmetros do include: cancelHref e submitLabel.
   ============================================================================= */
var __cancelHref  = typeof cancelHref  !== 'undefined' ? cancelHref  : '/';
var __submitLabel = typeof submitLabel !== 'undefined' ? submitLabel : 'Salvar';
%>
<div class="px-6 py-4 border-t border-gray-100 flex flex-wrap justify-between items-center gap-3 bg-gray-50 rounded-b-xl">
    <p class="text-xs text-gray-400 order-2 sm:order-1">Campos com <span class="text-red-500">*</span> são obrigatórios.</p>
    <div class="flex items-center gap-3 order-1 sm:order-2 ml-auto">
        <a href="<%= __cancelHref %>"
           class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-600 font-medium hover:bg-white transition text-sm">Cancelar</a>
        <button type="submit"
            class="px-6 py-2.5 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition shadow-sm inline-flex items-center gap-2 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <%= __submitLabel %>
        </button>
    </div>
</div>
