<%
const indEdit = typeof indicador !== 'undefined' ? indicador : null;
const isEdit = !!indEdit;
const formAction = isEdit
    ? '/planejamento/' + plano.id + '/indicadores/' + indEdit.id + '/editar'
    : '/planejamento/' + plano.id + '/indicadores';
const pageTitle = isEdit ? 'Editar Indicador' : 'Nova Meta / Indicador';
%>
<div class="max-w-6xl mx-auto space-y-5">

    <%- include('../partials/form-header', {
        backHref: '/planejamento/' + plano.id,
        backTitle: 'Voltar ao plano',
        title: pageTitle,
        subtitle: 'Plano: <a href="/planejamento/' + plano.id + '" class="font-medium text-blue-600 hover:underline">' + plano.titulo + '</a>'
    }) %>

    <form action="<%= formAction %>" method="POST" id="form-ind"
          class="bg-white rounded-xl border border-gray-200 shadow-sm">

        <!-- 2-column grid -->
        <div class="p-6 grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-x-8 gap-y-5">

            <!-- ─── Coluna esquerda: nome + descrição ─── -->
            <div class="space-y-5">

                <!-- Nome do Indicador -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                        Indicador <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="indicador" id="titulo-indicador" required
                        value="<%= indEdit ? indEdit.indicador : '' %>"
                        placeholder="Ex: Eventos realizados, Releases publicados..."
                        class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                </div>

                <!-- Descrição (Quill + IA) -->
                <div class="flex-1">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-sm font-semibold text-gray-700">
                            Descrição <span class="text-gray-400 font-normal text-xs">(opcional)</span>
                        </label>
                        <span class="text-xs text-gray-400">Suporta formatação</span>
                    </div>
                    <%- include('../partials/quill-ia-field', {
                        editorId: 'ed-indicador',
                        inputName: 'descricao',
                        titleInputId: 'titulo-indicador',
                        placeholder: 'Contexto, método de medição, fonte dos dados...',
                        initialHtml: indEdit ? (indEdit.descricao || '') : ''
                    }) %>
                </div>

            </div>

            <!-- ─── Coluna direita: valores e progresso ─── -->
            <div class="space-y-5">

                <div class="bg-gray-50 rounded-xl border border-gray-100 p-5 space-y-5">
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Valores do Indicador</p>

                    <!-- Meta -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                            Meta <span class="text-red-500">*</span>
                        </label>
                        <input type="number" name="valor_meta" required min="0" step="any"
                            value="<%= indEdit ? indEdit.valor_meta : '' %>"
                            placeholder="100"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                    </div>

                    <!-- Valor Atual -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Valor Atual</label>
                        <input type="number" name="valor_atual" min="0" step="any"
                            value="<%= indEdit ? indEdit.valor_atual : '0' %>"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                    </div>

                    <!-- Unidade -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Unidade</label>
                        <input type="text" name="unidade"
                            value="<%= indEdit ? (indEdit.unidade || 'unidades') : 'unidades' %>"
                            placeholder="eventos, %, posts..."
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                    </div>

                    <!-- Preview de progresso (se editando) -->
                    <% if (indEdit && indEdit.valor_meta > 0) { %>
                    <%
                    const pctPrev = Math.min(Math.round((indEdit.valor_atual / indEdit.valor_meta) * 100), 100);
                    const pctColor = pctPrev >= 100 ? 'bg-emerald-500' : pctPrev >= 60 ? 'bg-blue-500' : pctPrev >= 30 ? 'bg-amber-500' : 'bg-red-400';
                    %>
                    <div class="pt-2 border-t border-gray-200">
                        <div class="flex items-center justify-between text-xs text-gray-500 mb-2">
                            <span class="font-semibold text-gray-600">Progresso atual</span>
                            <span class="font-bold text-gray-800 text-sm"><%= pctPrev %>%</span>
                        </div>
                        <div class="h-2.5 bg-gray-200 rounded-full overflow-hidden">
                            <div class="h-full <%= pctColor %> rounded-full transition-all" style="width:<%= pctPrev %>%"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-2">
                            <%= indEdit.valor_atual %> de <%= indEdit.valor_meta %> <%= indEdit.unidade %>
                        </p>
                    </div>
                    <% } %>

                </div>

                <!-- Dica -->
                <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-xs text-blue-700 space-y-1.5">
                    <p class="font-semibold">Dica</p>
                    <p>Defina metas mensuráveis e realistas. Use a unidade adequada: número absoluto, percentual (%), ou outra medida específica.</p>
                </div>

            </div>

        </div>

        <%- include('../partials/form-footer', {
            cancelHref: '/planejamento/' + plano.id,
            submitLabel: isEdit ? 'Salvar Alterações' : 'Criar Indicador'
        }) %>
    </form>
</div>
